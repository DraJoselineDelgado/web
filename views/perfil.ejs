<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Perfil de Usuario</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        .profile-img {
            max-width: 180px;
            max-height: 180px;
            object-fit: cover;
            border-radius: 50%;
            border: 3px solid #007bff;
        }
        
        .profile-info-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1rem;
            border-bottom: 3px solid #007bff;
            padding-bottom: 0.3rem;
        }
        
        .profile-info-title {
            font-size: 2rem;
            font-weight: 700;
            color: #007bff;
            margin: 0;
        }
        
        .col-md-8 {
            margin-top: 50px;
        }
        
        .edit-btn-container a.btn {
            padding: 0.375rem 0.75rem;
            font-size: 0.875rem;
        }
    </style>
</head>

<body>
    <%- include('HOMEheader') %>

        <div class="container my-5">
            <h1 class="mb-4 text-center">Mi Perfil</h1>

            <div class="row">
                <div class="col-md-4 text-center">
                    <% if (user.foto_perfil) { %>
                        <img src="/uploads/<%= user.foto_perfil %>" alt="Foto de Perfil" class="profile-img mb-3" />
                        <% } else { %>
                            <img src="/images/default-profile.png" alt="Foto por Defecto" class="profile-img mb-3" />
                            <% } %>
                </div>

                <div class="col-md-8">
                    <div class="profile-info-header">
                        <h2 class="profile-info-title">Información Personal y Médica</h2>
                        <div class="edit-btn-container">
                            <a href="/EditPerfil" class="btn btn-primary btn-sm">Editar Perfil</a>
                        </div>
                    </div>

                    <table class="table table-striped">
                        <tbody>
                            <tr>
                                <th>Nombre</th>
                                <td>
                                    <%= user.nombre || 'No registrado' %>
                                </td>
                            </tr>
                            <tr>
                                <th>Correo</th>
                                <td>
                                    <%= user.correo || 'No registrado' %>
                                </td>
                            </tr>
                            <tr>
                                <th>Sexo</th>
                                <td>
                                    <%= user.sexo || 'No registrado' %>
                                </td>
                            </tr>
                            <tr>
                                <th>Cédula</th>
                                <td>
                                    <%= user.cedula || 'No registrado' %>
                                </td>
                            </tr>
                            <tr>
                                <th>Edad</th>
                                <td>
                                    <%= user.edad || 'No registrado' %>
                                </td>
                            </tr>
                            <tr>
                                <th>Celular</th>
                                <td>
                                    <%= user.celular || 'No registrado' %>
                                </td>
                            </tr>
                            <tr>
                                <th>Ciudad</th>
                                <td>
                                    <%= user.ciudad || 'No registrado' %>
                                </td>
                            </tr>
                            <tr>
                                <th>Barrio</th>
                                <td>
                                    <%= user.barrio || 'No registrado' %>
                                </td>
                            </tr>
                            <tr>
                                <th>Ocupación</th>
                                <td>
                                    <%= user.ocupacion || 'No registrado' %>
                                </td>
                            </tr>
                            <tr>
                                <th>Grupo Sanguíneo</th>
                                <td>
                                    <%= user.grupo_sanguineo || 'No registrado' %>
                                </td>
                            </tr>
                            <tr>
                                <th>Alergias</th>
                                <td>
                                    <%= user.alergias || 'No registrado' %>
                                </td>
                            </tr>
                            <tr>
                                <th>Antecedentes Personales</th>
                                <td>
                                    <%= user.antecedentes_personales || 'No registrado' %>
                                </td>
                            </tr>
                            <tr>
                                <th>Antecedentes Familiares</th>
                                <td>
                                    <%= user.antecedentes_familiares || 'No registrado' %>
                                </td>
                            </tr>
                            <tr>
                                <th>Medicamentos Actuales</th>
                                <td>
                                    <%= user.medicamentos_actuales || 'No registrado' %>
                                </td>
                            </tr>
                            <tr>
                                <th>Cirugías</th>
                                <td>
                                    <%= user.cirugias || 'No registrado' %>
                                </td>
                            </tr>
                            <tr>
                                <th>Enfermedades Crónicas</th>
                                <td>
                                    <%= user.enfermedades_cronicas || 'No registrado' %>
                                </td>
                            </tr>
                            <tr>
                                <th>Enfermedades Contagiosas Recientes</th>
                                <td>
                                    <%= user.enfermedades_contagiosas_recientes || 'No registrado' %>
                                </td>
                            </tr>
                            <tr>
                                <th>Fuma</th>
                                <td>
                                    <%= user.fuma ? 'Sí' : 'No' %>
                                </td>
                            </tr>
                            <tr>
                                <th>Consume Alcohol</th>
                                <td>
                                    <%= user.alcohol ? 'Sí' : 'No' %>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

</body>

</html>