<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dra. Josseline Delgado</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/5.0.0-alpha1/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
    <style>
        /* Estilos para el menú desplegable */
        
        .dropdown {
            position: relative;
            display: inline-block;
        }
        
        .dropdown-content {
            display: none;
            position: absolute;
            background-color: #d6d1d1;
            min-width: 160px;
            box-shadow: 0px 8px 16px 0px rgba(0, 0, 0, 0.2);
            z-index: 1;
        }
        
        .dropdown-content a {
            color: black;
            padding: 12px 16px;
            text-decoration: none;
            display: block;
        }
        
        .dropdown-content a:hover {
            background-color: #ebeaea;
        }
        
        .dropdown:hover .dropdown-content {
            display: block;
        }
        /* Estilos para el nombre y especialidad */
        
        .navbar-brand {
            font-family: Arial, sans-serif;
        }
        
        .navbar-brand span:first-child {
            font-weight: bold;
            color: #ffffff;
            /* Cambio de color aquí */
        }
        
        .navbar-brand span:last-child {
            font-weight: bold;
            color: #ffffff;
            font-size: 15px;
        }
        /* Estilos para el menú de navegación */
        
        .nav-link {
            font-size: 17px;
            font-weight: bold;
            color: #aad9ee;
            /* Cambio de color aquí */
        }
        /* Centra las opciones del menú a la derecha */
        
        .navbar-nav {
            margin-left: auto;
        }
        /* Estilos para el icono de usuario */
        
        .user-icon {
            color: #ffffff;
            /* Cambio de color aquí */
            font-size: 24px;
            margin-right: 10px;
        }
    </style>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark" style="background-color: #3d98dd;">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" href="/admin-home">
                    <img src="/images/logo.png" alt="Logo" class="mr-4" style="max-height: 80px;">
                    <div>
                        <span>Dra. Joseline Delgado</span>
                        <br>
                        <span>Odontología Especializada</span>
                    </div>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" href="/admin-home">Inicio</a>
                        </li>
                        <li class="nav-item dropdown">
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link" href="#" role="button">
                                <i class="fas fa-user-circle user-icon"></i>
                            </a>
                            <div class="dropdown-content">
                                <a href="/admin-login">Cerrar Sesión</a>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
</body>

</html>