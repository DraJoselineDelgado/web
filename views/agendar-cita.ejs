<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.1.3/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.9.1/font/bootstrap-icons.css" />
    <title>Agendar Cita - Consultorio Odontológico</title>
    <style>
        body {
            margin: 0;
            padding: 0;
        }
        
        .fadeIn {
            opacity: 0;
            animation: fadeIn 0.5s ease-in-out forwards;
        }
        
        @keyframes fadeIn {
            0% {
                opacity: 0;
            }
            100% {
                opacity: 1;
            }
        }
        
        .form-control,
        .form-select {
            margin-bottom: 1rem;
            border: 1px solid #ced4da;
            border-radius: 0.25rem;
        }
        
        .form-label {
            font-weight: bold;
        }
        /* Estilo para el botón de búsqueda con lupa */
        
        .search-button {
            background-color: #0d6efd;
            border: none;
            color: white;
            padding: 0.375rem 0.5rem;
            border-radius: 0.375rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background-color 0.3s ease;
            font-size: 1.1rem;
            width: 38px;
            height: 38px;
        }
        
        .search-button:hover {
            background-color: #0b5ed7;
        }
    </style>
</head>

<body>
    <%- include('HOMEheader') %>

        <div class="container my-5 fadeIn">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <h1 class="m-0 text-center flex-grow-1">Agendar Cita</h1>

                <a href="/citas-agendadas" class="btn btn-outline-primary">
                    <i class="bi bi-calendar-check"></i> Ver mis citas
                </a>
            </div>

            <% if (message) { %>
                <div class="alert alert-<%= message.type %> alert-dismissible fade show" role="alert">
                    <%= message.text %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
                <% } %>

                    <form id="appointment-form" action="/agendar-cita" method="POST">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="cedula" class="form-label">Cédula</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" id="cedula" name="cedula" required value="<%= formData.cedula || '' %>" />
                                        <button class="search-button" type="button" id="search-button" aria-label="Buscar">
                                <i class="bi bi-search"></i>
                            </button>
                                    </div>
                                    <div id="cedula-error" class="text-danger"></div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="nombre" class="form-label">Nombre Completo</label>
                                    <input type="text" class="form-control" id="nombre" name="nombre" readonly value="<%= formData.nombre || '' %>" />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="fecha" class="form-label">Fecha de la Cita</label>
                                    <input type="date" class="form-control" id="fecha" name="fecha" required value="<%= formData.fecha || '' %>" min="<%= new Date().toISOString().split('T')[0] %>" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="hora" class="form-label">Hora de la Cita</label>
                                    <input type="time" class="form-control" id="hora" name="hora" required value="<%= formData.hora || '' %>" min="08:00" max="17:00" step="1800" />
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="especialidad" class="form-label">Especialidad</label>
                            <select class="form-select" id="especialidad" name="especialidad" required>
                    <option value="">Seleccione el servicio</option>
                    <option value="Odontología General" <%= formData.especialidad === 'Odontología General' ? 'selected' : '' %>>
                        Odontología General
                    </option>
                    <option value="Ortodoncia" <%= formData.especialidad === 'Ortodoncia' ? 'selected' : '' %>>
                        Ortodoncia
                    </option>
                    <option value="Cirugía de tercer molares"
                        <%= formData.especialidad === 'Cirugía de tercer molares' ? 'selected' : '' %>>
                        Cirugía de tercer molares
                    </option>
                    <option value="Restauración Estética"
                        <%= formData.especialidad === 'Restauración Estética' ? 'selected' : '' %>>
                        Restauración Estética
                    </option>
                    <option value="Odontopediatria" <%= formData.especialidad === 'Odontopediatria' ? 'selected' : '' %>>
                        Odontopediatría
                    </option>
                    <option value="Exodoncia" <%= formData.especialidad === 'Exodoncia' ? 'selected' : '' %>>
                        Exodoncia
                    </option>
                    <option value="Endodoncia" <%= formData.especialidad === 'Endodoncia' ? 'selected' : '' %>>
                        Endodoncia
                    </option>
                    <option value="Profilaxis" <%= formData.especialidad === 'Profilaxis' ? 'selected' : '' %>>
                        Profilaxis
                    </option>
                    <option value="Aclaramiento Dental" <%= formData.especialidad === 'Aclaramiento Dental' ? 'selected' : '' %>>
                        Aclaramiento Dental
                    </option>
                    <option value="Prótesis fijas y removibles"
                        <%= formData.especialidad === 'Prótesis fijas y removibles' ? 'selected' : '' %>>
                        Prótesis fijas y removibles
                    </option>
                </select>

                            <div style="
            margin-top: 0.5rem;
            padding: 0.75rem 1rem;
            background-color: #f8d7da;
            color: #842029;
            border: 1px solid #f5c2c7;
            border-radius: 0.375rem;
            font-weight: 600;
            font-size: 0.9rem;
            max-width: fit-content;
          ">
                                Nota: No olvide actualizar su perfil para poder agendar su cita.
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <a href="/EditPerfil" class="btn btn-secondary">
                                <i class="bi bi-pencil-square"></i> Editar Perfil
                            </a>
                            <button type="submit" class="btn btn-primary">Agendar Cita</button>
                            <a href="/obtener-citas" class="btn btn-outline-secondary ms-3">
                                <i class="bi bi-calendar-event"></i> Calendario
                            </a>
                        </div>
                    </form>
        </div>

        <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.1.3/js/bootstrap.bundle.min.js"></script>
        <script>
            const cedulaInput = document.getElementById('cedula');
            const nombreInput = document.getElementById('nombre');
            const cedulaErrorDiv = document.getElementById('cedula-error');
            const searchButton = document.getElementById('search-button');

            searchButton.addEventListener('click', () => {
                const cedula = cedulaInput.value;

                if (cedula.length >= 10) {
                    fetch(`/obtener-datos-paciente?cedula=${cedula}`)
                        .then((response) => {
                            if (response.ok) {
                                return response.json();
                            } else {
                                throw new Error('Error al obtener los datos del paciente');
                            }
                        })
                        .then((data) => {
                            nombreInput.value = data.nombre;
                            cedulaErrorDiv.textContent = '';
                        })
                        .catch((error) => {
                            console.error(error);
                            cedulaErrorDiv.textContent = 'Paciente no encontrado';
                        });
                } else {
                    cedulaErrorDiv.textContent = 'La cédula debe tener al menos 10 dígitos';
                }
            });

            window.addEventListener('load', () => {
                document.querySelector('.fadeIn').style.opacity = '1';
            });
        </script>

</body>

</html>