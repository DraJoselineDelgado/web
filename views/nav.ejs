<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dra. Josseline Delgado</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/5.0.0-alpha1/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" />
    <style>
        /* Estilos para el menú desplegable */
        
        .dropdown {
            position: relative;
            display: inline-block;
        }
        
        .dropdown-content {
            display: none;
            position: absolute;
            background-color: #dad9d9;
            min-width: 160px;
            box-shadow: 0px 8px 16px rgba(0, 0, 0, 0.2);
            z-index: 1;
            border-radius: 6px;
            overflow: hidden;
        }
        
        .dropdown-content a {
            color: black;
            padding: 12px 16px;
            text-decoration: none;
            display: block;
            transition: background-color 0.2s ease;
        }
        
        .dropdown-content a:hover {
            background-color: #c8c7c7;
        }
        
        .dropdown:hover .dropdown-content {
            display: block;
        }
        /* Estilos para el nombre y especialidad */
        
        .navbar-brand {
            font-family: Arial, sans-serif;
        }
        
        .navbar-brand span:first-child {
            font-weight: bold;
            color: #f0f8ff;
            /* AliceBlue */
            font-size: 20px;
        }
        
        .navbar-brand span:last-child {
            font-weight: bold;
            color: #dbeeff;
            font-size: 16px;
        }
        /* Estilos para el menú de navegación */
        
        .nav-link {
            font-size: 18px;
            font-weight: 600;
            color: #e6f0ff;
            /* Blanco suave */
            transition: color 0.3s ease;
        }
        
        .nav-link:hover,
        .nav-link:focus {
            color: #c0d8ff;
            /* Azul claro */
            text-decoration: none;
        }
        /* Centra las opciones del menú a la derecha */
        
        .navbar-nav {
            margin-left: auto;
        }
        /* Estilos para el icono de usuario */
        
        .user-icon {
            color: #f0f8ff;
            font-size: 26px;
            margin-right: 10px;
        }
    </style>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark" style="background-color: #3d98dd;">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" href="/">
                    <img src="/images/logo.png" alt="Logo" class="me-4" style="max-height: 80px;" />
                    <div>
                        <span>Dra. Joseline Delgado</span><br />
                        <span>Odontología Especializada</span>
                    </div>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="/">Inicio</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link" href="#" role="button">Contacto</a>
                            <div class="dropdown-content">
                                <a href="https://wa.me/593993942467" target="_blank">WhatsApp</a>

                            </div>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link" href="#" role="button">Especialidades</a>
                            <div class="dropdown-content">
                                <a href="/cirugia">Cirugía de Tercer Molares</a>
                                <a href="/estetica">Odontología General</a>
                                <a href="/ortodoncia">Ortodoncia</a>
                                <a href="/otras">Otras Especialidades</a>
                            </div>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/register">Agendar Cita</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link" href="#" role="button">
                                <i class="fas fa-user-circle user-icon"></i>
                            </a>
                            <div class="dropdown-content">
                                <a href="/login">Inicio Sesión</a>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>