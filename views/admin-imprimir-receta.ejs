<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <title>Receta Médica -
        <%= paciente.nombre %>
    </title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 40px;
            background-color: #fefefe;
            color: #333;
        }
        
        .header-logo {
            text-align: center;
            margin-bottom: 20px;
        }
        
        .header-logo img {
            max-height: 80px;
            margin-bottom: 10px;
        }
        
        .doctor-name {
            font-weight: 700;
            font-size: 1.2rem;
            color: #004085;
            font-family: 'Arial Black', Arial, sans-serif;
            letter-spacing: 0.05em;
        }
        
        h1 {
            text-align: center;
            color: #004085;
            margin-bottom: 30px;
            text-transform: uppercase;
            font-weight: 700;
            border-bottom: 3px solid #007bff;
            padding-bottom: 10px;
        }
        
        .btn-print {
            background-color: #007bff;
            color: white;
            border: none;
            padding: 10px 20px;
            font-weight: 600;
            cursor: pointer;
            border-radius: 5px;
            display: block;
            margin: 0 auto 20px auto;
        }
        
        .btn-print:hover {
            background-color: #0056b3;
        }
        
        @media print {
            .btn-print {
                display: none;
            }
        }
        
        .datos-paciente {
            margin-bottom: 30px;
        }
        
        .datos-paciente p {
            margin: 4px 0;
        }
        
        .contenido-receta {
            display: flex;
            gap: 20px;
            align-items: stretch;
        }
        
        .bloque {
            flex: 1;
            border: 1px solid #ccc;
            border-radius: 6px;
            padding: 15px;
            background-color: #fff;
        }
        
        .separator {
            width: 3px;
            background: linear-gradient(to bottom, #007bff, #0056b3);
            border-radius: 4px;
        }
        
        h3 {
            color: #0056b3;
            margin-bottom: 10px;
            text-align: center;
        }
        
        pre {
            white-space: pre-wrap;
            font-family: monospace;
            color: #555;
            font-size: 15px;
        }
        
        .footer-firma {
            margin-top: 60px;
            text-align: right;
            font-weight: bold;
            font-size: 14px;
        }
    </style>
</head>

<body>
    <button class="btn-print" onclick="window.print()">🖨️ Imprimir Receta Médica</button>

    <div class="header-logo">
        <img src="/images/Logo.jpg" alt="Logo del consultorio" />
        <div class="doctor-name">Dra. Joseline Delgado<br>Odontología Especializada</div>
    </div>

    <h1>Receta Médica
    </h1>

    <div class="datos-paciente">
        <p><strong>Nombre:</strong>
            <%= paciente.nombre %>
        </p>
        <p><strong>Cédula:</strong>
            <%= paciente.cedula %>
        </p>
    </div>

    <div class="contenido-receta">
        <div class="bloque">
            <h3>Medicamentos</h3>
            <pre><%= historial.medicamentos || 'No especificado' %></pre>
        </div>

        <div class="separator"></div>

        <div class="bloque">
            <h3>Prescripción</h3>
            <pre><%= historial.prescripcion || 'No especificado' %></pre>
        </div>
    </div>

    <div class="footer-firma">
        ____________________________<br> Firma y sello de la doctora
    </div>
</body>

</html>