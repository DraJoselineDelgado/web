<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Citas Agendadas - Recepcionista</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/5.0.0-alpha1/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.9.1/font/bootstrap-icons.css" rel="stylesheet" />
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
    <style>
        .dropdown {
            position: relative;
            display: inline-block;
        }
        
        .dropdown-content {
            display: none;
            position: absolute;
            background-color: #d6d1d1;
            min-width: 160px;
            box-shadow: 0px 8px 16px rgba(0, 0, 0, 0.2);
            z-index: 1;
        }
        
        .dropdown-content a {
            color: black;
            padding: 12px 16px;
            text-decoration: none;
            display: block;
        }
        
        .dropdown-content a:hover {
            background-color: #ebeaea;
        }
        
        .dropdown:hover .dropdown-content {
            display: block;
        }
        
        .navbar-brand {
            font-family: Arial, sans-serif;
        }
        
        .navbar-brand span:first-child {
            font-weight: bold;
            color: #ffffff;
        }
        
        .navbar-brand span:last-child {
            font-weight: bold;
            color: #ffffff;
            font-size: 15px;
        }
        
        .nav-link {
            font-size: 17px;
            font-weight: bold;
            color: #aad9ee;
        }
        
        .navbar-nav {
            margin-left: auto;
        }
        
        .user-icon {
            color: #ffffff;
            font-size: 24px;
            margin-right: 10px;
        }
    </style>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark" style="background-color: #3d98dd;">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" href="/admin-home">
                    <img src="/images/logo.png" alt="Logo" class="mr-4" style="max-height: 80px;">
                    <div>
                        <span>Dra. Joseline Delgado</span><br>
                        <span>Odontología Especializada</span>
                    </div>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" href="/admin-recepcionista">Inicio</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link" href="#" role="button">
                                <i class="fas fa-user-circle user-icon"></i>
                            </a>
                            <div class="dropdown-content">
                                <a href="/admin-login">Cerrar Sesión</a>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- CONTENIDO PRINCIPAL -->
    <div class="container mt-5">
        <h1 class="text-center mb-4">Citas Agendadas</h1>

        <div class="text-end mb-3">
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalAgregarCita">Agregar Nueva Cita</button>
        </div>

        <% if (!citas || citas.length === 0) { %>
            <div class="alert alert-info text-center">No hay citas agendadas.</div>
            <% } else { %>
                <table class="table table-bordered table-striped">
                    <thead class="table-dark">
                        <tr>
                            <th>Cédula</th>
                            <th>Nombre</th>
                            <th>Fecha</th>
                            <th>Hora</th>
                            <th>Especialidad</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% citas.forEach(cita => { %>
                            <tr>
                                <td>
                                    <%= cita.cedula %>
                                </td>
                                <td>
                                    <%= cita.nombre %>
                                </td>
                                <td>
                                    <%= new Date(cita.fecha).toLocaleDateString() %>
                                </td>
                                <td>
                                    <%= cita.hora.slice(0,5) %>
                                </td>
                                <td>
                                    <%= cita.especialidad %>
                                </td>
                                <td>
                                    <a href="/recepcionista/citas/editar/<%= cita.id %>" class="btn btn-warning btn-sm">
                                        <i class="bi bi-pencil-square"></i> Editar
                                    </a>
                                    <button class="btn btn-danger btn-sm" onclick="eliminarCita(<%= cita.id %>)">
        <i class="bi bi-trash"></i> Eliminar
    </button>
                                </td>

                            </tr>

                            <% }) %>
                    </tbody>
                </table>
                <% } %>
    </div>

    <!-- MODAL AGREGAR CITA -->
    <div class="modal fade" id="modalAgregarCita" tabindex="-1" aria-labelledby="modalAgregarCitaLabel" aria-hidden="true">
        <div class="modal-dialog">
            <form class="modal-content" id="formAgregarCita" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title" id="modalAgregarCitaLabel">Agregar Nueva Cita</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">

                    <div class="mb-3 input-group">
                        <input type="text" class="form-control" name="cedula" id="inputCedula" placeholder="Cédula" required />
                        <button type="button" class="btn btn-outline-secondary" id="btnBuscarCedula">
                        <i class="bi bi-search"></i>
                    </button>
                    </div>

                    <div class="mb-3">
                        <label for="usuario_id" class="form-label">ID Usuario</label>
                        <input type="text" class="form-control" name="usuario_id" id="inputUsuarioId" readonly required />
                    </div>

                    <div class="mb-3">
                        <label for="nombre" class="form-label">Nombre</label>
                        <input type="text" class="form-control" name="nombre" id="inputNombre" readonly required />
                    </div>

                    <div class="mb-3">
                        <label for="fecha" class="form-label">Fecha</label>
                        <input type="date" class="form-control" name="fecha" id="inputFecha" required />
                    </div>

                    <div class="mb-3">
                        <label for="hora" class="form-label">Hora</label>
                        <input type="time" class="form-control" name="hora" required />
                    </div>

                    <div class="mb-3">
                        <label for="especialidad" class="form-label">Especialidad</label>
                        <select class="form-select" name="especialidad" required>
                        <option value="">Seleccione el servicio</option>
                        <option value="Odontología General">Odontología General</option>
                        <option value="Ortodoncia">Ortodoncia</option>
                        <option value="Cirugía de tercer molares">Cirugía de tercer molares</option>
                        <option value="Restauración Estética">Restauración Estética</option>
                        <option value="Odontopediatría">Odontopediatría</option>
                        <option value="Exodoncia">Exodoncia</option>
                        <option value="Endodoncia">Endodoncia</option>
                        <option value="Profilaxis">Profilaxis</option>
                        <option value="Aclaramiento Dental">Aclaramiento Dental</option>
                        <option value="Prótesis fijas y removibles">Prótesis fijas y removibles</option>
                    </select>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success">Guardar Cita</button>
                </div>
            </form>
        </div>
    </div>
    <!-- MODAL ELIMINAR MENSAJE -->
    <div class="modal fade" id="modalMensaje" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content bg-light">
                <div class="modal-body text-center fw-bold" id="mensajeTexto"></div>
            </div>
        </div>
    </div>

    <script>
        // Función para mostrar mensajes flotantes
        function mostrarMensaje(texto, tipo = 'success') {
            const mensajeModal = new bootstrap.Modal(document.getElementById('modalMensaje'));
            const mensajeTexto = document.getElementById('mensajeTexto');
            mensajeTexto.textContent = texto;
            mensajeTexto.className = 'text-' + (tipo === 'success' ? 'success' : 'danger');
            mensajeModal.show();
            setTimeout(() => mensajeModal.hide(), 3000);
        }

        // Función para eliminar cita
        async function eliminarCita(id) {
            if (!confirm('¿Está seguro de eliminar esta cita?')) return;
            try {
                const res = await fetch(`/recepcionista/citas/eliminar/${id}`, {
                    method: 'DELETE'
                });
                const result = await res.json();
                if (res.ok) {
                    mostrarMensaje(result.success || 'Cita eliminada');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    mostrarMensaje(result.error || 'Error al eliminar', 'danger');
                }
            } catch (err) {
                mostrarMensaje('Error al conectar con el servidor', 'danger');
            }
        }
    </script>


    <!-- MODAL ALERTA -->
    <div class="modal fade " id="modalMensaje " tabindex="-1 " aria-hidden="true ">
        <div class="modal-dialog ">
            <div class="modal-content bg-light ">
                <div class="modal-body text-center fw-bold " id="mensajeTexto "></div>
            </div>
        </div>
    </div>
    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js "></script>
    <script>
        // Mostrar mensaje flotante
        function mostrarMensaje(texto, tipo = 'success') {
            const mensajeModal = new bootstrap.Modal(document.getElementById('modalMensaje'));
            const mensajeTexto = document.getElementById('mensajeTexto');
            mensajeTexto.textContent = texto;
            mensajeTexto.className = 'text-' + (tipo === 'success' ? 'success' : 'danger');
            mensajeModal.show();
            setTimeout(() => mensajeModal.hide(), 3000);
        }

        // Fecha mínima actual
        const inputFecha = document.getElementById('inputFecha');
        const hoy = new Date().toISOString().split('T')[0];
        inputFecha.min = hoy;

        // Validar fecha futura
        inputFecha.addEventListener('change', () => {
            if (inputFecha.value < hoy) {
                mostrarMensaje('Seleccione una fecha actual o futura', 'danger');
                inputFecha.value = '';
            }
        });

        // Buscar usuario por cédula
        document.getElementById('btnBuscarCedula').addEventListener('click', async() => {
            const cedula = document.getElementById('inputCedula').value.trim();
            if (!cedula) return mostrarMensaje('Ingrese la cédula para buscar', 'danger');

            try {
                const response = await fetch(`/api/buscar-usuario?cedula=${cedula}`);
                const data = await response.json();
                if (data.error) {
                    mostrarMensaje(data.error, 'danger');
                } else {
                    document.getElementById('inputNombre').value = data.nombre;
                    document.getElementById('inputUsuarioId').value = data.id;
                }
            } catch (error) {
                mostrarMensaje('Error al conectar con el servidor', 'danger');
            }
        });

        // Guardar cita
        document.getElementById('formAgregarCita').addEventListener('submit', async function(event) {
            event.preventDefault();
            if (!this.checkValidity()) return this.reportValidity();

            const formData = new FormData(this);
            const data = {};
            formData.forEach((value, key) => data[key] = value);

            try {
                const response = await fetch('/recepcionista/citas/agregar', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                });
                const result = await response.json();

                if (!response.ok) {
                    mostrarMensaje(result.error || 'Error al guardar cita', 'danger');
                } else {
                    mostrarMensaje(result.success || 'Cita agendada correctamente');
                    this.reset();
                    bootstrap.Modal.getInstance(document.getElementById('modalAgregarCita')).hide();
                    setTimeout(() => location.reload(), 2000);
                }
            } catch (error) {
                mostrarMensaje('Error al conectar con el servidor', 'danger');
            }
        });
    </script>
</body>

</html>