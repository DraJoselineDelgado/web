<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dashboard Recepcionista</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.9.1/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" />
    <style>
        /* Estilos para el menú desplegable */
        
        .dropdown {
            position: relative;
            display: inline-block;
        }
        
        .dropdown-content {
            display: none;
            position: absolute;
            background-color: #d6d1d1;
            min-width: 160px;
            box-shadow: 0px 8px 16px rgba(0, 0, 0, 0.2);
            z-index: 1;
        }
        
        .dropdown-content a {
            color: black;
            padding: 12px 16px;
            text-decoration: none;
            display: block;
        }
        
        .dropdown-content a:hover {
            background-color: #ebeaea;
        }
        
        .dropdown:hover .dropdown-content {
            display: block;
        }
        /* Estilos para el nombre y especialidad */
        
        .navbar-brand {
            font-family: Arial, sans-serif;
        }
        
        .navbar-brand span:first-child {
            font-weight: bold;
            color: #ffffff;
        }
        
        .navbar-brand span:last-child {
            font-weight: bold;
            color: #ffffff;
            font-size: 15px;
        }
        /* Estilos para el menú de navegación */
        
        .nav-link {
            font-size: 17px;
            font-weight: bold;
            color: #aad9ee;
        }
        /* Centra las opciones del menú a la derecha */
        
        .navbar-nav {
            margin-left: auto;
        }
        /* Estilos para el icono de usuario */
        
        .user-icon {
            color: #ffffff;
            font-size: 24px;
            margin-right: 10px;
        }
        /* Navbar custom */
        
        nav.navbar {
            background-color: #3d98dd;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
        }
        /* Contenido principal */
        
        .container-main {
            max-width: 900px;
            margin: 30px auto 60px;
            background: white;
            padding: 25px;
            border-radius: 8px;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
            text-align: center;
        }
        
        .btn-dashboard {
            width: 160px;
            height: 160px;
            margin: 15px;
            border-radius: 18px;
            font-size: 1rem;
            display: inline-flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            background-color: #0d6efd;
            color: white;
            text-decoration: none;
            box-shadow: 0 5px 12px rgba(13, 110, 253, 0.3);
            transition: background-color 0.3s ease;
        }
        
        .btn-dashboard:hover {
            background-color: #084298;
            color: white;
            text-decoration: none;
        }
        
        .btn-dashboard i {
            font-size: 3rem;
            margin-bottom: 10px;
        }
        
        .clock {
            font-family: 'Courier New', monospace;
            font-weight: 700;
            font-size: 1.5rem;
            letter-spacing: 2px;
            user-select: none;
            color: white;
            width: 100%;
            text-align: center;
        }
    </style>
</head>

<body>
    <!-- Barra de navegación integrada -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" href="/admin-home">
                    <img src="/images/logo.png" alt="Logo" class="me-4" style="max-height: 80px;" />
                    <div>
                        <span>Dra. Joseline Delgado</span><br />
                        <span>Odontología Especializada</span>
                    </div>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" href="/admin-recepcionista">Inicio</a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link" href="#" role="button">
                                <i class="fas fa-user-circle user-icon"></i>
                            </a>
                            <div class="dropdown-content">
                                <a href="/admin-login">Cerrar Sesión</a>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Contenido principal -->
    <main>
        <div class="container-main">
            <h1>Menú Recepcionista</h1>

            <a href="/admin-recepcionista-citas" class="btn-dashboard" title="Agendar Cita">
                <i class="bi bi-plus-circle"></i> Agendar Cita
            </a>

            <div class="btn-dashboard" title="Hora Actual" id="clock">
                <i class="bi bi-clock"></i>
                <div class="clock" id="timeDisplay">--:--:--</div>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Actualizar reloj digital
        function updateClock() {
            const now = new Date();
            const h = String(now.getHours()).padStart(2, '0');
            const m = String(now.getMinutes()).padStart(2, '0');
            const s = String(now.getSeconds()).padStart(2, '0');
            document.getElementById('timeDisplay').textContent = `${h}:${m}:${s}`;
        }
        setInterval(updateClock, 1000);
        updateClock();
    </script>
</body>

</html>