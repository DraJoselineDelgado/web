    <style>
        .dropdown {
            position: relative;
            display: inline-block;
        }
        
        .dropdown-content {
            display: none;
            position: absolute;
            right: 0;
            background-color: #d6d1d1;
            min-width: 200px;
            max-height: 300px;
            overflow-y: auto;
            box-shadow: 0px 8px 16px rgba(0, 0, 0, 0.2);
            z-index: 10;
        }
        
        .dropdown-content a {
            color: black;
            padding: 12px 16px;
            text-decoration: none;
            display: block;
            background-color: #f2f2f2;
        }
        
        .dropdown-content a.unread {
            background-color: #d3d3d3;
        }
        
        .dropdown-content a:hover {
            background-color: #ebeaea;
        }
        
        .dropdown:hover .dropdown-content.menu {
            display: block;
        }
        
        .navbar-brand {
            font-family: Arial, sans-serif;
        }
        
        .navbar-brand span:first-child {
            font-weight: bold;
            color: #f0f8ff;
            font-size: 20px;
        }
        
        .navbar-brand span:last-child {
            font-weight: bold;
            color: #dbeeff;
            font-size: 16px;
        }
        
        .nav-link {
            font-size: 18px;
            font-weight: 600;
            color: #e6f0ff;
        }
        
        .nav-link:hover,
        .nav-link:focus {
            color: #c0d8ff;
            text-decoration: none;
        }
        
        .navbar-nav {
            margin-left: auto;
        }
        
        .user-icon,
        .bell-icon {
            color: #f0f8ff;
            font-size: 26px;
            margin-right: 10px;
            cursor: pointer;
        }
        
        .notification-dropdown {
            position: relative;
        }
        
        .notification-content {
            display: none;
            position: absolute;
            right: 0;
            background-color: #fff;
            min-width: 250px;
            max-height: 300px;
            overflow-y: auto;
            border: 1px solid #ccc;
            box-shadow: 0px 8px 16px rgba(0, 0, 0, 0.2);
            z-index: 20;
            margin-top: 10px;
        }
        
        .notification-item {
            padding: 10px 15px;
            border-bottom: 1px solid #eee;
            cursor: pointer;
        }
        
        .notification-item.unread {
            background-color: #d3d3d3;
        }
        
        .notification-item.read {
            background-color: #ffffff;
        }
        
        .badge-counter {
            position: absolute;
            top: -5px;
            right: 0;
            background-color: red;
            color: white;
            border-radius: 50%;
            font-size: 10px;
            padding: 2px 6px;
        }
    </style>
</head>

