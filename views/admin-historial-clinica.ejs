<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Historial Clínico -
        <%= paciente ? paciente.nombre : 'Paciente' %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.9.1/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        .preserve-whitespace {
            white-space: pre-wrap;
        }
        
        .odontograma-btn {
            width: 60px;
            height: 60px;
            text-align: center;
            font-size: 12px;
            padding: 5px;
            cursor: pointer;
            user-select: none;
        }
        
        .btn-primary {
            background-color: #0d6efd !important;
            color: white !important;
        }
        
        .btn-outline-secondary {
            background-color: transparent !important;
            color: #6c757d !important;
        }
    </style>
</head>

<body>
    <%- include('adminHOMEheader') %>

        <div class="container my-4">
            <h2 class="mb-3">Historial Clínico de
                <%= paciente ? paciente.nombre : 'Paciente' %>
            </h2>

            <div class="mb-4">
                <a href="/admin/historiales-clinicos/<%= paciente.id %>" class="btn btn-outline-primary me-2">
                    <i class="bi bi-folder2-open"></i> Ver Todos los Historiales Clínicos
                </a>
            </div>

            <% if (mensaje) { %>
                <div class="alert alert-info">
                    <%= mensaje %>
                </div>
                <% } %>

                    <section id="formHistorial" class="card p-4 shadow-sm bg-white rounded">
                        <h4>Crear Historial Clínico</h4>
                        <form action="/admin/historial-clinico/<%= paciente.id %>/crear" method="POST">
                            <input type="hidden" name="usuario_id" value="<%= paciente.id %>" />

                            <div class="mb-3 row">
                                <div class="col-md-6">
                                    <label for="codigo_hc" class="form-label">Código HC</label>
                                    <input type="text" id="codigo_hc" name="codigo_hc" class="form-control" value="<%= paciente.cedula %>" readonly />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Cédula</label>
                                    <input type="text" class="form-control" value="<%= paciente.cedula %>" readonly />
                                </div>
                            </div>

                            <!-- Diagnóstico -->
                            <div class="mb-3 row">
                                <div class="col-md-6">
                                    <label for="codigo_diagnostico" class="form-label">Código Diagnóstico</label>
                                    <input type="text" class="form-control" id="codigo_diagnostico" name="codigo_diagnostico" list="listaCodigos" placeholder="Ej: K024">
                                </div>
                                <div class="col-md-6">
                                    <label for="nombre_diagnostico" class="form-label">Nombre Diagnóstico</label>
                                    <input type="text" class="form-control" id="nombre_diagnostico" name="nombre_diagnostico" list="listaNombres" placeholder="Ej: ODONTOCLASIA">
                                </div>
                            </div>

                            <datalist id="listaCodigos"></datalist>
                            <datalist id="listaNombres"></datalist>

                            <!-- Odontograma -->
                            <div class="mb-3">
                                <label class="form-label">Odontograma</label>
                                <div class="mb-2 d-flex align-items-center gap-2">
                                    <select id="selectorPieza" class="form-select w-auto">
              <option disabled selected>Seleccionar pieza...</option>
              <% const piezas = [ '11 Incisivo Central Sup. Derecho', '12 Incisivo Lateral Sup. Derecho', '13 Canino Sup. Derecho',
              '14 Primer Premolar Sup. Derecho', '15 Segundo Premolar Sup. Derecho', '16 Primer Molar Sup. Derecho',
              '17 Segundo Molar Sup. Derecho', '18 Tercer Molar Sup. Derecho', '21 Incisivo Central Sup. Izquierdo',
              '22 Incisivo Lateral Sup. Izquierdo', '23 Canino Sup. Izquierdo', '24 Primer Premolar Sup. Izquierdo',
              '25 Segundo Premolar Sup. Izquierdo', '26 Primer Molar Sup. Izquierdo', '27 Segundo Molar Sup. Izquierdo',
              '28 Tercer Molar Sup. Izquierdo', '31 Incisivo Central Inf. Izquierdo', '32 Incisivo Lateral Inf. Izquierdo',
              '33 Canino Inf. Izquierdo', '34 Primer Premolar Inf. Izquierdo', '35 Segundo Premolar Inf. Izquierdo',
              '36 Primer Molar Inf. Izquierdo', '37 Segundo Molar Inf. Izquierdo', '38 Tercer Molar Inf. Izquierdo',
              '41 Incisivo Central Inf. Derecho', '42 Incisivo Lateral Inf. Derecho', '43 Canino Inf. Derecho',
              '44 Primer Premolar Inf. Derecho', '45 Segundo Premolar Inf. Derecho', '46 Primer Molar Inf. Derecho',
              '47 Segundo Molar Inf. Derecho', '48 Tercer Molar Inf. Derecho' ]; %>
              <% piezas.forEach((pieza, i) => { %>
                <option value="<%= i + 1 %>"><%= pieza %></option>
              <% }) %>
            </select>
                                    <button type="button" id="btnAgregarPieza" class="btn btn-success">Agregar al Odontograma</button>
                                </div>

                                <div id="odontogramaGrafico" class="d-flex flex-wrap gap-2 border p-3 rounded bg-light">
                                    <% piezas.forEach((pieza, i) => { %>
                                        <button type="button" class="btn btn-outline-secondary odontograma-btn" data-id="<%= i + 1 %>" title="<%= pieza %>">
                <%= pieza.split(' ')[0] %>
              </button>
                                        <% }) %>
                                </div>
                                <input type="hidden" name="odontograma_json" id="odontograma_json">
                            </div>

                            <div class="mb-3">
                                <label for="tratamientos" class="form-label">Tratamientos</label>
                                <textarea id="tratamientos" name="tratamientos" class="form-control" rows="4" required></textarea>
                            </div>

                            <div class="mb-3">
                                <label for="medicamentos" class="form-label">Medicamentos</label>
                                <textarea id="medicamentos" name="medicamentos" class="form-control" rows="3" required></textarea>
                            </div>

                            <div class="mb-3">
                                <label for="prescripcion" class="form-label">Prescripción</label>
                                <textarea id="prescripcion" name="prescripcion" class="form-control" rows="3" required></textarea>
                            </div>

                            <div class="mb-3">
                                <label for="observaciones" class="form-label">Observaciones</label>
                                <textarea id="observaciones" name="observaciones" class="form-control" rows="3"></textarea>
                            </div>

                            <button type="submit" class="btn btn-primary">Guardar Historial Clínico</button>
                        </form>
                    </section>
        </div>

        <div class="position-fixed top-0 end-0 p-3" style="z-index: 1080;">
            <div id="toastMensaje" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body" id="toastBody"></div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Cerrar"></button>
                </div>
            </div>
        </div>

        <script>
            const piezasSeleccionadas = new Set();
            const selector = document.getElementById('selectorPieza');
            const btnAgregar = document.getElementById('btnAgregarPieza');
            const odontogramaGrafico = document.getElementById('odontogramaGrafico');
            const odontogramaInput = document.getElementById('odontograma_json');

            function actualizarInput() {
                odontogramaInput.value = JSON.stringify([...piezasSeleccionadas]);
            }

            btnAgregar.addEventListener('click', () => {
                const id = selector.value;
                if (!id) return;
                const btn = odontogramaGrafico.querySelector(`[data-id="${id}"]`);
                if (btn && !piezasSeleccionadas.has(id)) {
                    piezasSeleccionadas.add(id);
                    btn.classList.remove('btn-outline-secondary');
                    btn.classList.add('btn-primary');
                }
                actualizarInput();
            });

            odontogramaGrafico.addEventListener('click', (e) => {
                if (e.target.classList.contains('odontograma-btn')) {
                    const id = e.target.dataset.id;
                    if (piezasSeleccionadas.has(id)) {
                        piezasSeleccionadas.delete(id);
                        e.target.classList.remove('btn-primary');
                        e.target.classList.add('btn-outline-secondary');
                    } else {
                        piezasSeleccionadas.add(id);
                        e.target.classList.remove('btn-outline-secondary');
                        e.target.classList.add('btn-primary');
                    }
                    actualizarInput();
                }
            });

            actualizarInput();

            document.addEventListener('DOMContentLoaded', () => {
                const mensaje = "<%= typeof mensaje !== 'undefined' ? mensaje : '' %>";
                const tipo = "<%= typeof tipoMensaje !== 'undefined' ? tipoMensaje : 'success' %>";
                if (mensaje) {
                    const toastEl = document.getElementById('toastMensaje');
                    const toastBody = document.getElementById('toastBody');
                    toastBody.textContent = mensaje;
                    toastEl.classList.remove('bg-success', 'bg-danger');
                    toastEl.classList.add(tipo === 'error' ? 'bg-danger' : 'bg-success');
                    const toast = new bootstrap.Toast(toastEl);
                    toast.show();
                }
            });

            // Cargar datos de diagnóstico
            fetch("/json/diagnosticos_odontologia.json")
                .then(res => res.json())
                .then(data => {
                    const listaCodigos = document.getElementById('listaCodigos');
                    const listaNombres = document.getElementById('listaNombres');
                    const inputCodigo = document.getElementById('codigo_diagnostico');
                    const inputNombre = document.getElementById('nombre_diagnostico');

                    data.forEach(item => {
                        const optCodigo = document.createElement('option');
                        optCodigo.value = item.codigo;
                        listaCodigos.appendChild(optCodigo);

                        const optNombre = document.createElement('option');
                        optNombre.value = item.nombre;
                        listaNombres.appendChild(optNombre);
                    });

                    inputCodigo.addEventListener('input', () => {
                        const found = data.find(d => d.codigo.toLowerCase() === inputCodigo.value.toLowerCase());
                        if (found) inputNombre.value = found.nombre;
                    });

                    inputNombre.addEventListener('input', () => {
                        const found = data.find(d => d.nombre.toLowerCase() === inputNombre.value.toLowerCase());
                        if (found) inputCodigo.value = found.codigo;
                    });
                });
        </script>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>