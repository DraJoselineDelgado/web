<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ortodoncia - Odontología Especializada Dra. Josseline Delgado</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f5f7fa;
            color: #333;
            margin: 0;
            padding: 0;
        }
        
        .hero-section {
            background-size: cover;
            background-position: center;
            height: 350px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            color: white;
            text-shadow: 0 0 10px rgba(0, 0, 0, 0.7);
            padding: 0 20px;
        }
        
        .hero-section h1 {
            font-size: 3rem;
            font-weight: 700;
            color: #0d6efd;
            margin-bottom: 0.25rem;
            text-shadow: none;
        }
        
        .hero-section p {
            font-size: 1.3rem;
            font-weight: 500;
            max-width: 700px;
            margin: 0 auto;
            color: #444;
        }
        
        .container-custom {
            max-width: 1140px;
            margin: 50px auto 70px;
            padding: 0 15px;
        }
        /* Info cards arriba */
        
        .info-cards {
            display: flex;
            gap: 30px;
            margin-bottom: 60px;
            flex-wrap: wrap;
            justify-content: center;
        }
        
        .info-card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            padding: 20px 25px;
            max-width: 500px;
            flex: 1 1 400px;
            color: #444;
            display: flex;
            flex-direction: row;
            gap: 20px;
            align-items: center;
        }
        
        .info-card img {
            width: 120px;
            height: 120px;
            object-fit: cover;
            border-radius: 12px;
            flex-shrink: 0;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.12);
        }
        
        .info-content {
            flex: 1;
        }
        
        .info-card h3 {
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 15px;
            color: #0d6efd;
        }
        
        .info-card p,
        .info-card ul {
            font-size: 1.1rem;
            line-height: 1.6;
            margin-bottom: 0;
        }
        
        .info-card ul {
            padding-left: 1.2rem;
            margin-top: 10px;
        }
        
        .info-card ul li {
            margin-bottom: 8px;
        }
        
        .services-section {
            text-align: center;
            margin-bottom: 60px;
        }
        
        .services-section h2 {
            font-weight: 700;
            font-size: 2.5rem;
            color: #0d6efd;
            margin-bottom: 40px;
        }
        
        .service-container {
            display: flex;
            flex-wrap: wrap;
            gap: 30px;
            justify-content: center;
        }
        
        .service-box {
            background: white;
            border-radius: 15px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
            padding: 30px 25px;
            width: 300px;
            transition: box-shadow 0.3s ease, transform 0.3s ease;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            align-items: center;
            user-select: none;
        }
        
        .service-box:hover {
            box-shadow: 0 18px 35px rgba(0, 0, 0, 0.15);
            transform: translateY(-8px);
        }
        
        .service-box img {
            max-width: 120px;
            border-radius: 12px;
            margin-bottom: 20px;
            object-fit: cover;
        }
        
        .service-box h3 {
            font-size: 1.3rem;
            font-weight: 600;
            margin-bottom: 12px;
            color: #0a58ca;
        }
        
        .service-box p {
            font-size: 1rem;
            color: #555;
            margin-bottom: 20px;
            flex-grow: 1;
            text-align: center;
        }
        
        .service-box a.btn {
            background-color: #0d6efd;
            color: white;
            font-weight: 600;
            padding: 8px 18px;
            border-radius: 8px;
            text-decoration: none;
            transition: background-color 0.3s ease;
        }
        
        .service-box a.btn:hover {
            background-color: #0b5ed7;
        }
        /* Modal Styling */
        
        .modal-header {
            background-color: #0d6efd;
            color: white;
            font-weight: 600;
        }
    </style>
</head>

<body>
    <%- include('HOMEheader') %>

        <section class="hero-section">
            <h1>Ortodoncia</h1>
            <p>Tratamientos avanzados para sonrisas perfectas</p>
        </section>

        <main class="container-custom">

            <!-- Sección info arriba -->
            <section class="info-cards" aria-label="Información relevante sobre ortodoncia">
                <article class="info-card">
                    <img src="/images/prevencion.jpg" alt="Prevención Ortodoncia" />
                    <div class="info-content">
                        <h3>Prevención y Cuidado</h3>
                        <p>La ortodoncia no solo mejora la estética, también previene problemas dentales como:</p>
                        <ul>
                            <li>Mala mordida y desgastes dentales</li>
                            <li>Dificultades para la higiene oral</li>
                            <li>Dolores mandibulares y cefaleas</li>
                            <li>Problemas de pronunciación</li>
                        </ul>
                        <p>Cuida tu sonrisa siguiendo las indicaciones de tu especialista y manteniendo limpiezas regulares.</p>
                    </div>
                </article>

                <article class="info-card">
                    <img src="/images/beneficios.jpeg" alt="Beneficios Ortodoncia" />
                    <div class="info-content">
                        <h3>Beneficios de la Ortodoncia</h3>
                        <p>Los tratamientos de ortodoncia ofrecen múltiples ventajas:</p>
                        <ul>
                            <li>Mejora la alineación dental y la función masticatoria</li>
                            <li>Incrementa la confianza y la sonrisa</li>
                            <li>Reduce el riesgo de caries y enfermedades periodontales</li>
                            <li>Corrige problemas de habla y postura mandibular</li>
                        </ul>
                    </div>
                </article>
            </section>

            <section class="services-section" aria-label="Tratamientos de ortodoncia">
                <h2>Nuestros Tratamientos de Ortodoncia</h2>
                <div class="service-container">
                    <div class="service-box" tabindex="0" role="button" aria-pressed="false" onclick="mostrarMensaje('Ortodoncia Metálica Autoligado: Tecnología avanzada y comodidad en el tratamiento.')">
                        <img src="/images/ortodoncia-metalica.jpg" alt="Ortodoncia Metálica Autoligado" />
                        <h3>Ortodoncia Metálica Autoligado</h3>
                        <p>Comodidad y eficacia con tecnología de vanguardia.</p>
                        <a href="/agendar-cita" class="btn btn-primary btn-sm" aria-label="Agendar cita para Ortodoncia Metálica">Agendar</a>
                    </div>

                    <div class="service-box" tabindex="0" role="button" aria-pressed="false" onclick="mostrarMensaje('Ortodoncia Invisible: Tratamiento estético sin alambres ni ligas.')">
                        <img src="/images/ortodoncia-invisible.jpg" alt="Ortodoncia Invisible" />
                        <h3>Ortodoncia Invisible</h3>
                        <p>La solución discreta para corregir tu sonrisa.</p>
                        <a href="/agendar-cita" class="btn btn-primary btn-sm" aria-label="Agendar cita para Ortodoncia Invisible">Agendar</a>
                    </div>
                </div>
            </section>
        </main>

        <!-- Modal para mostrar mensajes -->
        <div class="modal fade" id="infoModal" tabindex="-1" aria-labelledby="infoModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title" id="infoModalLabel">Información del Tratamiento</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body" id="modalBodyContent"></div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>
        <footer class="bg-primary text-white py-3">
            <div class="container">
                <p class="mb-0">&copy; 2023 Dra. Josseline Delgado. Todos los derechos reservados.</p>
            </div>
        </footer>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            const infoModal = new bootstrap.Modal(document.getElementById('infoModal'));

            function mostrarMensaje(texto) {
                document.getElementById('modalBodyContent').textContent = texto;
                infoModal.show();
            }
        </script>
</body>

</html>