<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Editar Cita</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.9.1/font/bootstrap-icons.css" rel="stylesheet" />
</head>

<body>
    <%- include('HOMEheader') %>

        <div class="container my-5">
            <h1>Editar Cita</h1>

            <% if (message) { %>
                <div class="alert alert-<%= message.type %> alert-dismissible fade show" role="alert">
                    <%= message.text %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
                <% } %>

                    <form action="/editar-cita/<%= appointment.id %>" method="POST">
                        <div class="mb-3">
                            <label for="fecha" class="form-label">Fecha</label>
                            <input type="date" class="form-control" id="fecha" name="fecha" value="<%= appointment.fecha.toISOString().slice(0,10) %>" required />
                        </div>

                        <div class="mb-3">
                            <label for="hora" class="form-label">Hora</label>
                            <input type="time" class="form-control" id="hora" name="hora" value="<%= appointment.hora %>" required />
                        </div>

                        <div class="mb-3">
                            <label for="especialidad" class="form-label">Especialidad</label>
                            <select class="form-select" id="especialidad" name="especialidad" required>
          <option value="Odontología General" <%= appointment.especialidad === 'Odontología General' ? 'selected' : '' %>>Odontología General</option>
          <option value="Ortodoncia" <%= appointment.especialidad === 'Ortodoncia' ? 'selected' : '' %>>Ortodoncia</option>
          <option value="Cirugía de tercer molares" <%= appointment.especialidad === 'Cirugía de tercer molares' ? 'selected' : '' %>>Cirugía de tercer molares</option>
          <option value="Restauración Estética" <%= appointment.especialidad === 'Restauración Estética' ? 'selected' : '' %>>Restauración Estética</option>
          <option value="Odontopediatria" <%= appointment.especialidad === 'Odontopediatria' ? 'selected' : '' %>>Odontopediatría</option>
          <option value="Exodoncia" <%= appointment.especialidad === 'Exodoncia' ? 'selected' : '' %>>Exodoncia</option>
          <option value="Endodoncia" <%= appointment.especialidad === 'Endodoncia' ? 'selected' : '' %>>Endodoncia</option>
          <option value="Profilaxis" <%= appointment.especialidad === 'Profilaxis' ? 'selected' : '' %>>Profilaxis</option>
          <option value="Aclaramiento Dental" <%= appointment.especialidad === 'Aclaramiento Dental' ? 'selected' : '' %>>Aclaramiento Dental</option>
          <option value="Prótesis fijas y removibles" <%= appointment.especialidad === 'Prótesis fijas y removibles' ? 'selected' : '' %>>Prótesis fijas y removibles</option>
        </select>
                        </div>

                        <button type="submit" class="btn btn-primary">Actualizar Cita</button>
                        <a href="/citas-agendadas" class="btn btn-secondary ms-2">Volver</a>
                    </form>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>