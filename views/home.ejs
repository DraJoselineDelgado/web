<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.1.3/css/bootstrap.min.css">
    <title>Dra. Josseline Delgado - Odontología Especializada</title>
    <style>
        body {
            background-color: #f8f9fa;
            opacity: 0;
            animation: fadeIn 0.5s ease-in-out forwards;
        }
        
        @keyframes fadeIn {
            0% {
                opacity: 0;
            }
            100% {
                opacity: 1;
            }
        }
        
        .hero {
            background-color: #f8f9fa;
            padding: 60px 0;
            text-align: center;
            opacity: 0;
            animation: fadeIn 0.5s ease-in-out forwards 0.5s;
        }
        
        .hero h1 {
            font-size: 42px;
            font-weight: bold;
            margin-bottom: 16px;
        }
        
        .hero p {
            font-size: 20px;
            margin-bottom: 32px;
        }
        
        .hero video {
            max-width: 100%;
            height: auto;
            border-radius: 8px;
        }
        
        .service-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            grid-gap: 24px;
            opacity: 0;
            animation: fadeIn 0.5s ease-in-out forwards 1s;
        }
        
        .service-item {
            background-color: #fff;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            padding: 24px;
            text-align: center;
            transition: transform 0.3s ease;
        }
        
        .service-item:hover {
            transform: translateY(-5px);
        }
        
        .service-item img {
            max-width: 100%;
            height: auto;
            margin-bottom: 16px;
        }
        
        .service-item h3 {
            font-size: 20px;
            font-weight: bold;
            margin-bottom: 8px;
        }
        
        .service-item p {
            font-size: 14px;
            color: #6c757d;
            margin-bottom: 16px;
        }
        
        .service-item .btn {
            background-color: #007bff;
            color: #fff;
            border-radius: 4px;
            padding: 8px 16px;
            font-size: 14px;
            transition: background-color 0.3s ease;
        }
        
        .service-item .btn:hover {
            background-color: #0056b3;
        }
        
        .about-section {
            padding: 60px 0;
            opacity: 0;
            animation: fadeIn 0.5s ease-in-out forwards 1.5s;
        }
        
        .about-section h2 {
            font-size: 36px;
            font-weight: bold;
            margin-bottom: 24px;
        }
        
        .about-section p {
            font-size: 16px;
            color: #6c757d;
            margin-bottom: 16px;
        }
        
        .about-section img {
            max-width: 100%;
            height: auto;
            border-radius: 8px;
        }
        
        .location-section {
            padding: 60px 0;
            text-align: center;
            opacity: 0;
            animation: fadeIn 0.5s ease-in-out forwards 2s;
        }
        
        .location-section h3 {
            font-size: 28px;
            font-weight: bold;
            margin-bottom: 24px;
        }
        
        .location-section iframe {
            max-width: 100%;
            height: 400px;
            border: 0;
            border-radius: 8px;
        }
        
        .location-section .hours {
            margin-top: 24px;
            font-size: 18px;
        }
        
        footer {
            background-color: #007bff;
            color: #fff;
            padding: 16px 0;
            text-align: center;
        }
        
        footer p {
            margin-bottom: 0;
        }
    </style>
</head>

<body>
    <%- include('nav') %>
        <main>
            <section class="hero">
                <div class="container text-center">
                    <h1>Transformamos tu sonrisa, transformamos tu vida</h1>
                    <video src="/videos/videoo.mp4" controls autoplay loop muted class="img-fluid rounded-3" style="max-width: 65%; height: auto;"></video>
