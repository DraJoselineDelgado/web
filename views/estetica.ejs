<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css">
    <title>Estética Dental</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            background-color: #f8f9fa;
        }
        
        .hero-section {
            background-image: url('/images/estetica.jpg');
            background-size: cover;
            background-position: center;
            height: 400px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: white;
            text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.6);
            text-align: center;
            opacity: 0;
            transform: translateY(-20px);
            animation: fadeInUp 1s forwards;
        }
        
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .hero-section h1 {
            font-size: 48px;
            font-weight: bold;
            color: #007bff;
        }
        
        .hero-section p {
            font-size: 24px;
        }
        
        .services-section {
            padding: 60px 20px;
            text-align: center;
            opacity: 0;
            transform: translateY(20px);
            animation: fadeInUp 1s forwards 0.5s;
        }
        
        .services-section h2 {
            font-size: 36px;
            margin-bottom: 40px;
        }
        
        .service-container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 30px;
        }
        
        .service-box {
            background-color: #fff;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            padding: 30px;
            width: 300px;
            cursor: pointer;
            transition: transform 0.3s;
        }
        
        .service-box:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
        }
        
        .service-box img {
            max-width: 100px;
            margin-bottom: 20px;
        }
        
        .service-box h3 {
            font-size: 24px;
            margin-bottom: 10px;
        }
        
        .service-box p {
            font-size: 16px;
            color: #555;
        }
    </style>
</head>

<body>
    <%- include('nav') %>
        <div class="hero-section">
            <h1>Odontología General</h1>
            <p>Sonrisas radiantes y saludables</p>
        </div>

        <div class="services-section">
            <h2>Nuestros Servicios de Odontología General</h2>
            <div class="service-container">
                <div class="service-box" onclick="mostrarMensaje('Diseño de Sonrisa: Transforma tu sonrisa con análisis facial y dental.')">
                    <img src="/images/DiseñoSonrisa.jpg" alt="Diseño de Sonrisa">
                    <h3>Diseño de Sonrisa</h3>
                    <p>Proceso artístico que transforma tu sonrisa según tu rostro.</p>
                </div>

                <div class="service-box" onclick="mostrarMensaje('Blanqueamiento Dental: Tratamiento para aclarar el tono de tus dientes.')">
                    <img src="/images/Blanqueamiento.jpg" alt="Blanqueamiento Dental">
                    <h3>Aclaramiento Dental</h3>
                    <p>Elimina manchas y mejora el color de tus dientes.</p>
                </div>

                <div class="service-box" onclick="mostrarMensaje('Carillas Estéticas: Fragmentos cerámicos que mejoran forma y color dental.')">
                    <img src="/images/Carillas.jpg" alt="Carillas Estéticas">
                    <h3>Carillas Estéticas</h3>
                    <p>Mejora tu sonrisa con carillas de cerámica.</p>
                </div>
            </div>
        </div>

        <script>
            function mostrarMensaje(texto) {
                alert(texto);
            }
        </script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>