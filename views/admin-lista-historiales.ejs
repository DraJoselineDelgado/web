<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Todos los Historiales Clínicos</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.9.1/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        .preserve-whitespace {
            white-space: pre-wrap;
        }
        
        #toast-container {
            position: fixed;
            top: 1rem;
            right: 1rem;
            z-index: 1080;
        }
        
        .table .btn {
            margin: 2px;
        }
        
        .search-container {
            margin-bottom: 20px;
        }
        
        .form-control::placeholder {
            font-style: italic;
        }
    </style>
</head>

<body>
    <%- include('adminHOMEheader') %>

        <div class="container my-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="mb-0 flex-grow-1 text-center">Todos los Historiales Clínicos</h2>
                <a href="/admin-home" class="btn btn-primary ms-3">
                    <i class="bi bi-arrow-left-circle"></i> Volver al inicio
                </a>
            </div>

            <!-- Barra de búsqueda -->
            <div class="search-container">
                <input type="text" class="form-control" id="searchInput" placeholder="Buscar por nombre o cédula..." onkeyup="filtrarTabla()" />
            </div>

            <% if (historiales.length === 0) { %>
                <div class="alert alert-info">No hay historiales clínicos registrados.</div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-striped" id="tablaHistoriales">
                            <thead class="table-primary">
                                <tr>
                                    <th>Paciente</th>
                                    <th>Código HC</th>
                                    <th>Fecha</th>
                                    <th>Tratamientos</th>
                                    <th>Medicamentos</th>
                                    <th>Prescripción</th>
                                    <th>Observaciones</th>
                                    <th>Código Diagnóstico</th>
                                    <th>Nombre Diagnóstico</th>
                                    <th>Piezas Seleccionadas</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% historiales.forEach(hist => { 
                            const piezas = JSON.parse(hist.odontograma_json || "[]");
                        %>
                                    <tr>
                                        <td>
                                            <%= hist.nombre %> (
                                                <%= hist.cedula %>)</td>
                                        <td>
                                            <%= hist.codigo_hc %>
                                        </td>
                                        <td>
                                            <%= new Date(hist.created_at).toLocaleDateString() %>
                                        </td>
                                        <td><pre class="preserve-whitespace"><%= hist.tratamientos %></pre></td>
                                        <td><pre class="preserve-whitespace"><%= hist.medicamentos %></pre></td>
                                        <td><pre class="preserve-whitespace"><%= hist.prescripcion %></pre></td>
                                        <td><pre class="preserve-whitespace"><%= hist.observaciones %></pre></td>
                                        <td>
                                            <%= hist.codigo_diagnostico || '—' %>
                                        </td>
                                        <td>
                                            <%= hist.nombre_diagnostico || '—' %>
                                        </td>
                                        <td>
                                            <% if (piezas.length === 0) { %>
                                                <span class="text-muted">Ninguna</span>
                                                <% } else { %>
                                                    <ul class="mb-0 ps-3">
                                                        <% piezas.forEach(id => { %>
                                                            <li>Pieza
                                                                <%= id %>
                                                            </li>
                                                            <% }) %>
                                                    </ul>
                                                    <% } %>
                                        </td>
                                        <td>
                                            <div class="d-flex flex-wrap gap-2">
                                                <a href="/admin/historial-clinico/<%= hist.usuario_id %>" class="btn btn-outline-info btn-sm" title="Agregar HC">
                                                    <i class="bi bi-folder2-open"></i> Agregar HC
                                                </a>
                                                <a href="/admin/historial-clinico/<%= hist.usuario_id %>/editar/<%= hist.id %>" class="btn btn-outline-primary btn-sm" title="Editar">
                                                    <i class="bi bi-pencil-square"></i> Editar
                                                </a>
                                                <form action="/admin/historial-clinico/eliminar" method="POST" style="display:inline;">
                                                    <input type="hidden" name="id" value="<%= hist.id %>" />
                                                    <button class="btn btn-outline-danger btn-sm" type="submit" title="Eliminar">
                                                <i class="bi bi-trash"></i> Eliminar
                                            </button>
                                                </form>
                                                <a href="/admin/historiales-clinicos/<%= hist.usuario_id %>/imprimir" target="_blank" class="btn btn-outline-success btn-sm" title="Imprimir Historial Completo">
                                                    <i class="bi bi-printer"></i> Imprimir
                                                </a>
                                                <a href="/admin/historial-clinico/<%= hist.usuario_id %>/receta/<%= hist.id %>" target="_blank" class="btn btn-outline-warning btn-sm" title="Imprimir Receta Médica">
                                                    <i class="bi bi-file-earmark-medical"></i> Receta
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                    <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <% } %>
        </div>

        <script>
            function filtrarTabla() {
                const input = document.getElementById("searchInput").value.toLowerCase();
                const filas = document.querySelectorAll("#tablaHistoriales tbody tr");
                filas.forEach(fila => {
                    const texto = fila.textContent.toLowerCase();
                    fila.style.display = texto.includes(input) ? "" : "none";
                });
            }
        </script>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>