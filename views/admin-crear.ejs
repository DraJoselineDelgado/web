<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Agregar Usuario Administrativo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f0f4f8;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
        }
        
        .admin-container {
            max-width: 1100px;
            margin: 50px auto;
            background: white;
            border-radius: 12px;
            box-shadow: 0 8px 20px rgb(0 0 0 / 0.1);
            display: flex;
            gap: 40px;
            padding: 30px;
            height: 700px;
            overflow: hidden;
        }
        /* Columna formulario */
        
        .form-section {
            flex: 0 0 40%;
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            overflow-y: auto;
            padding-right: 10px;
            border-right: 1px solid #ddd;
        }
        /* Columna tabla */
        
        .table-section {
            flex: 0 0 55%;
            overflow-y: auto;
            padding-left: 10px;
        }
        
        h1 {
            font-weight: 700;
            font-size: 2rem;
            margin-bottom: 30px;
            color: #0d6efd;
            text-align: center;
        }
        
        form .form-label {
            font-weight: 600;
            color: #333;
            font-size: 1rem;
        }
        
        form .form-control {
            border-radius: 8px;
            box-shadow: none;
            font-size: 1.05rem;
            padding: 12px 15px;
            transition: border-color 0.3s ease;
        }
        
        form .form-control:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 6px rgba(13, 110, 253, 0.4);
        }
        
        .btn-primary {
            background-color: #0d6efd;
            border: none;
            padding: 12px 25px;
            font-weight: 700;
            font-size: 1.1rem;
            border-radius: 10px;
            transition: background-color 0.3s ease;
            box-shadow: 0 4px 15px rgb(13 110 253 / 0.3);
            width: 100%;
            margin-top: 10px;
        }
        
        .btn-primary:hover {
            background-color: #084298;
            box-shadow: 0 6px 18px rgb(8 66 152 / 0.5);
        }
        
        .btn-secondary {
            font-size: 1rem;
            padding: 10px 20px;
            border-radius: 10px;
            font-weight: 600;
            margin-top: 10px;
            width: 100%;
        }
        
        .btn-secondary:hover {
            background-color: #6c757d;
            color: white;
        }
        
        .form-actions {
            margin-top: 25px;
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            justify-content: center;
        }
        
        table {
            width: 100%;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgb(0 0 0 / 0.05);
            border-collapse: separate;
            border-spacing: 0;
        }
        
        table th,
        table td {
            text-align: center;
            vertical-align: middle;
            padding: 12px 15px;
            font-size: 1rem;
            border-bottom: 1px solid #ddd;
        }
        
        table thead {
            background-color: #0d6efd;
            color: white;
            font-weight: 700;
            font-size: 1.1rem;
        }
        
        table tbody tr:hover {
            background-color: #f0f4ff;
            transition: background-color 0.3s ease;
        }
        
        .btn-warning {
            background-color: #ffc107;
            border: none;
            font-weight: 600;
            transition: background-color 0.3s ease;
            padding: 6px 12px;
        }
        
        .btn-warning:hover {
            background-color: #d39e00;
            color: white;
        }
        
        .btn-danger {
            background-color: #dc3545;
            border: none;
            font-weight: 600;
            transition: background-color 0.3s ease;
            padding: 6px 12px;
        }
        
        .btn-danger:hover {
            background-color: #a71d2a;
            color: white;
        }
        /* Modal styles */
        
        .modal-content {
            border-radius: 12px;
            padding: 20px;
        }
        
        .modal-header {
            border-bottom: none;
        }
        
        .modal-title {
            font-weight: 700;
            font-size: 1.3rem;
            color: #0d6efd;
        }
        
        .modal-footer {
            border-top: none;
            justify-content: flex-end;
        }
        /* Alerta temporal estilo */
        
        #alerta-temporal {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 1100;
            border-radius: 10px;
            padding: 12px 28px;
            font-weight: 600;
            box-shadow: 0 4px 15px rgb(0 0 0 / 0.15);
            font-size: 1.1rem;
            max-width: 450px;
            text-align: center;
        }
    </style>
</head>

<body>
    <%- include('adminHOMEheader') %>

        <div class="admin-container">
            <!-- Formulario a la izquierda -->
            <section class="form-section">
                <h1>Agregar Usuario Administrativo</h1>

                <!-- Alerta temporal -->
                <div id="alerta-temporal" class="alert alert-success d-none" role="alert">
                    Usuario creado con éxito, actualice la página
                </div>

                <% if (error) { %>
                    <div class="alert alert-danger">
                        <%= error %>
                    </div>
                    <% } %>

                        <form id="formAgregarAdmin" action="/admin-crear" method="POST" novalidate>
                            <div class="mb-4">
                                <label for="usuario" class="form-label">Usuario:</label>
                                <input type="text" class="form-control" id="usuario" name="usuario" required />
                            </div>
                            <div class="mb-4">
                                <label for="contraseña" class="form-label">Contraseña:</label>
                                <input type="password" class="form-control" id="contraseña" name="contraseña" required />
                            </div>
                            <div class="mb-4">
                                <label for="rol" class="form-label">Rol:</label>
                                <select class="form-select" id="rol" name="rol" required>
                        <option value="">Seleccione un rol</option>
                        <option value="administrador">Administrador</option>
                        <option value="recepcionista">Recepcionista</option>
                        <!-- Puedes agregar más roles aquí -->
                    </select>
                            </div>
                            <div class="form-actions">
                                <button type="submit" class="btn btn-primary">Agregar Usuario</button>
                                <a href="/admin-home" class="btn btn-secondary">Volver</a>
                            </div>
                        </form>
            </section>

            <!-- Tabla a la derecha -->
            <section class="table-section">
                <h2 class="mb-4 text-center">Usuarios Existentes</h2>
                <table class="table table-hover table-striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Usuario</th>
                            <th>Rol</th>
                            <th style="width: 180px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% admins.forEach(admin => { %>
                            <tr id="admin-<%= admin.id %>">
                                <td>
                                    <%= admin.id %>
                                </td>
                                <td>
                                    <%= admin.usuario %>
                                </td>
                                <td>
                                    <%= admin.rol %>
                                </td>
                                <td>
                                    <a href="/admin-editar/<%= admin.id %>" class="btn btn-warning btn-sm me-2">Editar</a>
                                    <button type="button" class="btn btn-danger btn-sm btn-eliminar" data-id="<%= admin.id %>">Eliminar</button>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </section>
        </div>

        <!-- Modal Confirmación para eliminar -->
        <div class="modal fade" id="modalEliminarAdmin" tabindex="-1" aria-labelledby="modalEliminarAdminLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modalEliminarAdminLabel">Confirmar Eliminación</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">¿Está seguro que desea eliminar este usuario?</div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="button" class="btn btn-danger" id="btnConfirmarEliminar">Sí, eliminar</button>
                    </div>
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>

        <script>
            // Variables para manejo de eliminar
            let adminIdEliminar = null;
            const modalEliminar = new bootstrap.Modal(document.getElementById('modalEliminarAdmin'));
            const btnConfirmarEliminar = document.getElementById('btnConfirmarEliminar');
            const alertaTemporal = document.getElementById('alerta-temporal');

            // Al hacer click en eliminar
            document.querySelectorAll('.btn-eliminar').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    adminIdEliminar = e.target.getAttribute('data-id');
                    modalEliminar.show();
                });
            });

            // Confirmar eliminación
            btnConfirmarEliminar.addEventListener('click', async() => {
                if (!adminIdEliminar) return;

                try {
                    const response = await fetch(`/admin/eliminar/${adminIdEliminar}`, {
                        method: 'DELETE',
                        headers: {
                            'Content-Type': 'application/json'
                        }
                    });

                    if (response.ok) {
                        // Ocultar modal
                        modalEliminar.hide();

                        // Eliminar fila de la tabla
                        const fila = document.getElementById(`admin-${adminIdEliminar}`);
                        if (fila) fila.remove();

                        // Mostrar alerta temporal
                        mostrarAlerta('Usuario eliminado correctamente', 'success');
                    } else {
                        const errorData = await response.json();
                        mostrarAlerta(`Error: ${errorData.error || 'No se pudo eliminar'}`, 'danger');
                    }
                } catch (error) {
                    mostrarAlerta('Error al eliminar usuario', 'danger');
                }
            });

            // Mostrar alerta temporal
            function mostrarAlerta(mensaje, tipo = 'success') {
                alertaTemporal.textContent = mensaje;
                alertaTemporal.className = `alert alert-${tipo} position-fixed top-0 start-50 translate-middle-x mt-3`;
                alertaTemporal.classList.remove('d-none');

                setTimeout(() => {
                    alertaTemporal.classList.add('d-none');
                }, 3000);
            }

            // Formulario agregar usuario con mensaje temporal sin recargar página
            const formAgregarAdmin = document.getElementById('formAgregarAdmin');
            formAgregarAdmin.addEventListener('submit', async(e) => {
                e.preventDefault();

                const usuario = document.getElementById('usuario').value.trim();
                const contraseña = document.getElementById('contraseña').value.trim();
                const rol = document.getElementById('rol').value;

                if (!usuario || !contraseña || !rol) {
                    mostrarAlerta('Por favor complete todos los campos', 'warning');
                    return;
                }

                try {
                    const response = await fetch('/admin-crear', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            usuario,
                            contraseña,
                            rol
                        }),
                    });

                    if (response.ok) {
                        formAgregarAdmin.reset();
                        mostrarAlerta('Usuario creado con éxito, actualice la página', 'success');
                    } else {
                        const errorData = await response.json();
                        mostrarAlerta(errorData.error || 'Error al crear usuario', 'danger');
                    }
                } catch (error) {
                    mostrarAlerta('Error de conexión', 'danger');
                }
            });
        </script>
</body>

</html>