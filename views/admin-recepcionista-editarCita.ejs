<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Editar Cita</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.9.1/font/bootstrap-icons.css" rel="stylesheet" />
</head>

<body class="bg-light">
    <div class="container mt-5">
        <h2 class="text-center mb-4">Editar Cita</h2>

        <form id="formEditarCita">
            <input type="hidden" name="id" value="<%= cita.id %>" />

            <div class="mb-3">
                <label for="cedula" class="form-label">Cédula</label>
                <input type="text" class="form-control" id="cedula" name="cedula" value="<%= cita.cedula %>" readonly />
            </div>

            <div class="mb-3">
                <label for="nombre" class="form-label">Nombre</label>
                <input type="text" class="form-control" id="nombre" name="nombre" value="<%= cita.nombre %>" readonly />
            </div>

            <div class="mb-3">
                <label for="fecha" class="form-label">Fecha</label>
                <input type="date" class="form-control" id="fecha" name="fecha" value="<%= cita.fecha.toISOString().split('T')[0] %>" required />
            </div>

            <div class="mb-3">
                <label for="hora" class="form-label">Hora</label>
                <input type="time" class="form-control" id="hora" name="hora" value="<%= cita.hora %>" required />
            </div>

            <div class="mb-3">
                <label for="especialidad" class="form-label">Especialidad</label>
                <select class="form-select" id="especialidad" name="especialidad" required>
          <% const especialidades = [
              "Odontología General", "Ortodoncia", "Cirugía de tercer molares",
              "Restauración Estética", "Odontopediatría", "Exodoncia",
              "Endodoncia", "Profilaxis", "Aclaramiento Dental", "Prótesis fijas y removibles"
            ]; %>
          <% especialidades.forEach(especialidad => { %>
            <option value="<%= especialidad %>" <%= cita.especialidad === especialidad ? 'selected' : '' %>>
              <%= especialidad %>
            </option>
          <% }) %>
        </select>
            </div>

            <div class="d-flex justify-content-between">
                <a href="/recepcionista/citas" class="btn btn-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary">Guardar Cambios</button>
            </div>
        </form>
    </div>

    <!-- Modal flotante de mensaje -->
    <div class="modal fade" id="modalMensaje" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content bg-light">
                <div class="modal-body text-center fw-bold" id="mensajeTexto"></div>
            </div>
        </div>
    </div>

    <script>
        const inputFecha = document.getElementById('fecha');
        const hoy = new Date().toISOString().split('T')[0];
        inputFecha.min = hoy;

        inputFecha.addEventListener('change', () => {
            if (inputFecha.value < hoy) {
                mostrarMensaje('Seleccione una fecha actual o futura', 'danger');
                inputFecha.value = '';
            }
        });

        // Mostrar mensaje flotante
        function mostrarMensaje(texto, tipo = 'success') {
            const mensajeModal = new bootstrap.Modal(document.getElementById('modalMensaje'));
            const mensajeTexto = document.getElementById('mensajeTexto');
            mensajeTexto.textContent = texto;
            mensajeTexto.className = 'text-' + (tipo === 'success' ? 'success' : 'danger');
            mensajeModal.show();
        }

        document.getElementById('formEditarCita').addEventListener('submit', async function(event) {
            event.preventDefault();
            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());

            try {
                const res = await fetch(`/recepcionista/citas/editar/${data.id}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                });

                const result = await res.json();
                if (res.ok) {
                    mostrarMensaje(result.success || 'Cita actualizada');
                    setTimeout(() => location.href = 'admin-recepcionista', 2000);
                } else {
                    mostrarMensaje(result.error || 'Error al actualizar', 'danger');
                }
            } catch (error) {
                mostrarMensaje('Error al conectar con servidor', 'danger');
            }
        });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>