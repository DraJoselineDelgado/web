<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Editar Historial Clínico -
        <%= paciente.nombre %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        .odontograma-btn {
            width: 60px;
            height: 60px;
            font-size: 12px;
            padding: 5px;
            text-align: center;
        }
    </style>
</head>

<body>
    <%- include('adminHOMEheader') %>

        <div class="container my-4">
            <h2>Editar Historial Clínico de
                <%= paciente.nombre %>
            </h2>

            <form action="/admin/historial-clinico/<%= paciente.id %>/editar/<%= historial.id %>" method="POST">
                <div class="mb-3">
                    <label for="codigo_hc" class="form-label">Código HC</label>
                    <input type="text" id="codigo_hc" name="codigo_hc" class="form-control" value="<%= historial.codigo_hc %>" required />
                </div>

                <!-- Diagnóstico -->
                <div class="mb-3">
                    <label for="codigo_diagnostico" class="form-label">Código Diagnóstico</label>
                    <input list="listaCodigos" id="codigo_diagnostico" name="codigo_diagnostico" class="form-control" value="<%= historial.codigo_diagnostico || '' %>" />
                    <datalist id="listaCodigos"></datalist>
                </div>
                <div class="mb-3">
                    <label for="nombre_diagnostico" class="form-label">Nombre Diagnóstico</label>
                    <input list="listaNombres" id="nombre_diagnostico" name="nombre_diagnostico" class="form-control" value="<%= historial.nombre_diagnostico || '' %>" />
                    <datalist id="listaNombres"></datalist>
                </div>

                <!-- Odontograma -->
                <div class="mb-3">
                    <label class="form-label">Odontograma</label>
                    <div class="mb-2 d-flex gap-2 align-items-center">
                        <select id="selectorPieza" class="form-select w-auto">
                        <option value="">Seleccionar pieza...</option>
                        <% const piezas = [
                            '11 Incisivo Central Sup. Derecho', '12 Incisivo Lateral Sup. Derecho', '13 Canino Sup. Derecho',
                            '14 Primer Premolar Sup. Derecho', '15 Segundo Premolar Sup. Derecho', '16 Primer Molar Sup. Derecho',
                            '17 Segundo Molar Sup. Derecho', '18 Tercer Molar Sup. Derecho',
                            '21 Incisivo Central Sup. Izquierdo', '22 Incisivo Lateral Sup. Izquierdo', '23 Canino Sup. Izquierdo',
                            '24 Primer Premolar Sup. Izquierdo', '25 Segundo Premolar Sup. Izquierdo', '26 Primer Molar Sup. Izquierdo',
                            '27 Segundo Molar Sup. Izquierdo', '28 Tercer Molar Sup. Izquierdo',
                            '31 Incisivo Central Inf. Izquierdo', '32 Incisivo Lateral Inf. Izquierdo', '33 Canino Inf. Izquierdo',
                            '34 Primer Premolar Inf. Izquierdo', '35 Segundo Premolar Inf. Izquierdo', '36 Primer Molar Inf. Izquierdo',
                            '37 Segundo Molar Inf. Izquierdo', '38 Tercer Molar Inf. Izquierdo',
                            '41 Incisivo Central Inf. Derecho', '42 Incisivo Lateral Inf. Derecho', '43 Canino Inf. Derecho',
                            '44 Primer Premolar Inf. Derecho', '45 Segundo Premolar Inf. Derecho', '46 Primer Molar Inf. Derecho',
                            '47 Segundo Molar Inf. Derecho', '48 Tercer Molar Inf. Derecho'
                        ];
                        const seleccionadas = JSON.parse(historial.odontograma_json || "[]"); %>
                        <% piezas.forEach((pieza) => { const numeroReal = pieza.split(' ')[0]; %>
                            <option value="<%= numeroReal %>"><%= pieza %></option>
                        <% }) %>
                    </select>
                        <button type="button" id="btnAgregarPieza" class="btn btn-success">Agregar</button>
                    </div>

                    <div id="odontogramaGrafico" class="d-flex flex-wrap gap-2 border p-3 rounded bg-light">
                        <% piezas.forEach((pieza) => {
                        const numeroReal = pieza.split(' ')[0];
                        const seleccionada = seleccionadas.includes(numeroReal);
                    %>
                            <button type="button" class="btn odontograma-btn <%= seleccionada ? 'btn-primary' : 'btn-outline-secondary' %>" data-id="<%= numeroReal %>" title="<%= pieza %>">
                            <%= numeroReal %>
                        </button>
                            <% }) %>
                    </div>
                    <input type="hidden" name="odontograma_json" id="odontograma_json" />
                </div>

                <div class="mb-3">
                    <label for="tratamientos" class="form-label">Tratamientos</label>
                    <textarea id="tratamientos" name="tratamientos" class="form-control" rows="4" required><%= historial.tratamientos %></textarea>
                </div>
                <div class="mb-3">
                    <label for="medicamentos" class="form-label">Medicamentos</label>
                    <textarea id="medicamentos" name="medicamentos" class="form-control" rows="3" required><%= historial.medicamentos %></textarea>
                </div>
                <div class="mb-3">
                    <label for="prescripcion" class="form-label">Prescripción</label>
                    <textarea id="prescripcion" name="prescripcion" class="form-control" rows="3" required><%= historial.prescripcion %></textarea>
                </div>
                <div class="mb-3">
                    <label for="observaciones" class="form-label">Observaciones</label>
                    <textarea id="observaciones" name="observaciones" class="form-control" rows="3"><%= historial.observaciones %></textarea>
                </div>

                <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                <a href="/admin/historiales-clinicos/<%= paciente.id %>" class="btn btn-secondary">Cancelar</a>
            </form>
        </div>

        <script>
            const odontogramaInput = document.getElementById("odontograma_json");
            const odontogramaGrafico = document.getElementById("odontogramaGrafico");
            const selector = document.getElementById("selectorPieza");
            const btnAgregar = document.getElementById("btnAgregarPieza");

            const piezasSeleccionadas = new Set(<%- JSON.stringify(JSON.parse(historial.odontograma_json || "[]")) %>);

            function actualizarInput() {
                odontogramaInput.value = JSON.stringify([...piezasSeleccionadas]);
            }

            btnAgregar.addEventListener("click", () => {
                const piezaSeleccionadaTexto = selector.options[selector.selectedIndex].text;
                const piezaNumero = piezaSeleccionadaTexto.split(" ")[0];

                if (!piezaNumero) return;

                const btn = odontogramaGrafico.querySelector(`[data-id="${piezaNumero}"]`);
                if (btn && !piezasSeleccionadas.has(piezaNumero)) {
                    piezasSeleccionadas.add(piezaNumero);
                    btn.classList.remove("btn-outline-secondary");
                    btn.classList.add("btn-primary");
                    actualizarInput();
                }
            });

            odontogramaGrafico.addEventListener("click", (e) => {
                if (e.target.classList.contains("odontograma-btn")) {
                    const id = e.target.dataset.id;
                    if (piezasSeleccionadas.has(id)) {
                        piezasSeleccionadas.delete(id);
                        e.target.classList.remove("btn-primary");
                        e.target.classList.add("btn-outline-secondary");
                    } else {
                        piezasSeleccionadas.add(id);
                        e.target.classList.remove("btn-outline-secondary");
                        e.target.classList.add("btn-primary");
                    }
                    actualizarInput();
                }
            });

            actualizarInput();

            document.addEventListener('DOMContentLoaded', () => {
                const listaCodigos = document.getElementById('listaCodigos');
                const listaNombres = document.getElementById('listaNombres');
                const inputCodigo = document.getElementById('codigo_diagnostico');
                const inputNombre = document.getElementById('nombre_diagnostico');

                fetch("/json/diagnosticos_odontologia.json")
                    .then(res => res.json())
                    .then(data => {
                        data.forEach(item => {
                            const optCodigo = document.createElement('option');
                            optCodigo.value = item.codigo;
                            listaCodigos.appendChild(optCodigo);

                            const optNombre = document.createElement('option');
                            optNombre.value = item.nombre;
                            listaNombres.appendChild(optNombre);
                        });

                        inputCodigo.addEventListener('input', () => {
                            const found = data.find(d => d.codigo.toLowerCase() === inputCodigo.value.toLowerCase());
                            inputNombre.value = found ? found.nombre : '';
                        });

                        inputNombre.addEventListener('input', () => {
                            const found = data.find(d => d.nombre.toLowerCase() === inputNombre.value.toLowerCase());
                            inputCodigo.value = found ? found.codigo : '';
                        });
                    })
                    .catch(err => console.error("Error cargando diagnóstico:", err));
            });
        </script>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>