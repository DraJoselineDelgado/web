<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Otras Especialidades - Odontología Especializada Dra. Josseline Delgado</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f5f7fa;
            color: #333;
            margin: 0;
            padding: 0;
        }
        
        .hero-section {
            background-image: url('/images/otras-especialidades.jpg');
            background-size: cover;
            background-position: center;
            height: 350px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            color: white;
            text-shadow: 0 0 12px rgba(0, 0, 0, 0.7);
            padding: 0 20px;
        }
        
        .hero-section h1 {
            font-size: 3rem;
            font-weight: 700;
            color: #0d6efd;
            margin-bottom: 0.25rem;
            text-shadow: none;
        }
        
        .hero-section p {
            font-size: 1.3rem;
            font-weight: 500;
            max-width: 700px;
            margin: 0 auto;
            color: #444;
        }
        
        .container-custom {
            max-width: 1140px;
            margin: 50px auto 70px;
            padding: 0 15px;
        }
        
        .info-cards {
            display: flex;
            justify-content: space-between;
            gap: 30px;
            margin-bottom: 60px;
            flex-wrap: wrap;
        }
        
        .info-card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            padding: 20px 25px;
            max-width: 500px;
            flex: 1 1 400px;
            color: #444;
            display: flex;
            flex-direction: row;
            gap: 20px;
            align-items: center;
        }
        
        .info-card img {
            width: 150px;
            height: 150px;
            object-fit: cover;
            border-radius: 12px;
            flex-shrink: 0;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.12);
        }
        
        .info-content {
            flex: 1;
        }
        
        .info-card h3 {
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 15px;
            color: #0d6efd;
        }
        
        .info-card p,
        .info-card ul {
            font-size: 1.1rem;
            line-height: 1.6;
            margin-bottom: 0;
        }
        
        .info-card ul {
            padding-left: 1.2rem;
            margin-top: 10px;
        }
        
        .info-card ul li {
            margin-bottom: 8px;
        }
        
        .services-section {
            text-align: center;
            margin-bottom: 60px;
        }
        
        .services-section h2 {
            font-weight: 700;
            font-size: 2.5rem;
            color: #0d6efd;
            margin-bottom: 40px;
        }
        
        .service-container {
            display: flex;
            flex-wrap: wrap;
            gap: 30px;
            justify-content: center;
        }
        
        .service-box {
            background: white;
            border-radius: 15px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
            padding: 30px 25px;
            width: 300px;
            transition: box-shadow 0.3s ease, transform 0.3s ease;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            align-items: center;
            user-select: none;
        }
        
        .service-box:hover {
            box-shadow: 0 18px 35px rgba(0, 0, 0, 0.15);
            transform: translateY(-8px);
        }
        
        .service-box img {
            max-width: 120px;
            border-radius: 12px;
            margin-bottom: 20px;
            object-fit: cover;
        }
        
        .service-box h3 {
            font-size: 1.3rem;
            font-weight: 600;
            margin-bottom: 12px;
            color: #0a58ca;
        }
        
        .service-box p {
            font-size: 1rem;
            color: #555;
            margin-bottom: 20px;
            flex-grow: 1;
            text-align: center;
        }
        
        .service-box a.btn {
            background-color: #0d6efd;
            color: white;
            font-weight: 600;
            padding: 8px 18px;
            border-radius: 8px;
            text-decoration: none;
            transition: background-color 0.3s ease;
        }
        
        .service-box a.btn:hover {
            background-color: #0b5ed7;
        }
        /* Modal Styling */
        
        .modal-header {
            background-color: #0d6efd;
            color: white;
            font-weight: 600;
        }
    </style>
</head>

<body>
    <%- include('HOMEheader') %>

        <section class="hero-section" aria-label="Imagen y título principal de otras especialidades">
            <h1>Otras Especialidades</h1>
            <p>Tratamientos especializados para cada necesidad dental</p>
        </section>

        <main class="container-custom">

            <!-- Sección info arriba -->
            <section class="info-cards" aria-label="Información relevante sobre otras especialidades odontológicas">
                <article class="info-card">
                    <img src="/images/prevencion-otras.jpg" alt="Prevención y cuidado odontológico" />
                    <div class="info-content">
                        <h3>Prevención y Cuidado</h3>
                        <p>Para mantener una salud bucal óptima, es fundamental seguir estos consejos:</p>
                        <ul>
                            <li>Visitar al dentista regularmente para chequeos y limpiezas.</li>
                            <li>Adoptar una buena higiene oral diaria con cepillado y uso de hilo dental.</li>
                            <li>Evitar el consumo excesivo de azúcares y alimentos que dañan los dientes.</li>
                            <li>Utilizar protectores bucales para actividades deportivas.</li>
                        </ul>
                    </div>
                </article>

                <article class="info-card">
                    <img src="/images/beneficios-otras.png" alt="Beneficios de tratamientos dentales especializados" />
                    <div class="info-content">
                        <h3>Beneficios de los Tratamientos Especializados</h3>
                        <p>Estos tratamientos ofrecen beneficios como:</p>
                        <ul>
                            <li>Mejora en la función masticatoria y salud dental general.</li>
                            <li>Incremento de la autoestima y confianza en la sonrisa.</li>
                            <li>Prevención y tratamiento de problemas dentales complejos.</li>
                            <li>Resultados duraderos con atención personalizada.</li>
                        </ul>
                    </div>
                </article>
            </section>

            <!-- Sección servicios -->
            <section class="services-section" aria-label="Tratamientos especializados disponibles">
                <h2>Nuestros Tratamientos Especializados</h2>
                <div class="service-container">
                    <div class="service-box" tabindex="0" role="button" aria-pressed="false" onclick="mostrarMensaje('Endodoncia: Tratamiento de conductos para salvar dientes dañados.')">
                        <img src="/images/endodoncia.jpg" alt="Endodoncia" />
                        <h3>Endodoncia</h3>
                        <p>Tratamiento de conductos para salvar dientes dañados.</p>
                        <a href="/agendar-cita" class="btn btn-primary btn-sm" aria-label="Agendar cita para Endodoncia">Agendar</a>
                    </div>

                    <div class="service-box" tabindex="0" role="button" aria-pressed="false" onclick="mostrarMensaje('Odontopediatría: Atención dental especializada para niños.')">
                        <img src="/images/odontopediatria.jpg" alt="Odontopediatría" />
                        <h3>Odontopediatría</h3>
                        <p>Atención dental especializada para niños.</p>
                        <a href="/agendar-cita" class="btn btn-primary btn-sm" aria-label="Agendar cita para Odontopediatría">Agendar</a>
                    </div>

                    <div class="service-box" tabindex="0" role="button" aria-pressed="false" onclick="mostrarMensaje('Implantes Dentales: Soluciones permanentes para dientes perdidos.')">
                        <img src="/images/implantes-dentales.jpg" alt="Implantes Dentales" />
                        <h3>Implantes Dentales</h3>
                        <p>Soluciones permanentes para dientes perdidos.</p>
                        <a href="/agendar-cita" class="btn btn-primary btn-sm" aria-label="Agendar cita para Implantes Dentales">Agendar</a>
                    </div>

                    <div class="service-box" tabindex="0" role="button" aria-pressed="false" onclick="mostrarMensaje('Estética Dental: Mejora de la apariencia de tus dientes.')">
                        <img src="/images/estetica-dental.jpg" alt="Estética Dental" />
                        <h3>Estética Dental</h3>
                        <p>Mejora de la apariencia de tus dientes.</p>
                        <a href="/agendar-cita" class="btn btn-primary btn-sm" aria-label="Agendar cita para Estética Dental">Agendar</a>
                    </div>

                    <div class="service-box" tabindex="0" role="button" aria-pressed="false" onclick="mostrarMensaje('Exodoncia: Extracción de dientes que no pueden ser salvados.')">
                        <img src="/images/exodoncia.jpg" alt="Exodoncia" />
                        <h3>Exodoncia</h3>
                        <p>Extracción de dientes que no pueden ser salvados.</p>
                        <a href="/agendar-cita" class="btn btn-primary btn-sm" aria-label="Agendar cita para Exodoncia">Agendar</a>
                    </div>

                    <div class="service-box" tabindex="0" role="button" aria-pressed="false" onclick="mostrarMensaje('Profilaxis: Limpieza dental profesional para mantener la salud bucal.')">
                        <img src="/images/profilaxis.jpg" alt="Profilaxis" />
                        <h3>Profilaxis</h3>
                        <p>Limpieza dental profesional para mantener la salud bucal.</p>
                        <a href="/agendar-cita" class="btn btn-primary btn-sm" aria-label="Agendar cita para Profilaxis">Agendar</a>
                    </div>

                    <div class="service-box" tabindex="0" role="button" aria-pressed="false" onclick="mostrarMensaje('Prótesis Fijas y Removibles: Soluciones para reemplazar dientes perdidos.')">
                        <img src="/images/protesis.jpg" alt="Prótesis Fijas y Removibles" />
                        <h3>Prótesis Fijas y Removibles</h3>
                        <p>Soluciones para reemplazar dientes perdidos.</p>
                        <a href="/agendar-cita" class="btn btn-primary btn-sm" aria-label="Agendar cita para Prótesis Fijas y Removibles">Agendar</a>
                    </div>
                </div>
            </section>

        </main>

        <!-- Modal para mostrar mensajes -->
        <div class="modal fade" id="infoModal" tabindex="-1" aria-labelledby="infoModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title" id="infoModalLabel">Información del Tratamiento</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body" id="modalBodyContent"></div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>

        <footer class="bg-primary text-white py-3">
            <div class="container">
                <p class="mb-0">&copy; 2023 Dra. Josseline Delgado. Todos los derechos reservados.</p>
            </div>
        </footer>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

        <script>
            const infoModal = new bootstrap.Modal(document.getElementById('infoModal'));

            function mostrarMensaje(texto) {
                document.getElementById('modalBodyContent').textContent = texto;
                infoModal.show();
            }
        </script>
</body>

</html>