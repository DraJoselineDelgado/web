<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dashboard del Administrador</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.9.1/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f8f9fa;
        }
        
        .admin-container {
            max-width: 1200px;
            margin: 50px auto;
            padding: 30px;
            background-color: #fff;
            border-radius: 5px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            text-align: center;
        }
        
        .admin-container h1 {
            margin-bottom: 40px;
        }
        
        .dashboard-buttons {
            display: flex;
            justify-content: center;
            gap: 25px;
            flex-wrap: wrap;
        }
        
        .dashboard-button {
            width: 130px;
            height: 130px;
            border-radius: 15px;
            background-color: #0d6efd;
            color: white;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            font-size: 1rem;
            font-weight: 600;
            text-decoration: none;
            box-shadow: 0 5px 10px rgba(13, 110, 253, 0.3);
            transition: background-color 0.3s ease, transform 0.2s ease;
            user-select: none;
            position: relative;
            padding: 10px;
            text-align: center;
        }
        
        .dashboard-button:hover {
            background-color: #084298;
            transform: translateY(-3px);
            text-decoration: none;
            color: white;
        }
        
        .dashboard-button i {
            font-size: 2.8rem;
            margin-bottom: 8px;
            line-height: 1;
        }
        /* Reloj digital dentro del botón, texto blanco */
        
        .clock {
            font-family: 'Courier New', Courier, monospace;
            font-size: 1.2rem;
            font-weight: 700;
            color: white;
            letter-spacing: 3px;
            user-select: none;
            text-align: center;
            width: 100%;
            padding: 0 5px;
            line-height: 1.2;
        }
    </style>
</head>

<body>
    <%- include('adminHOMEheader') %>

        <div class="admin-container">
            <h1>Menú de Administración</h1>

            <div class="dashboard-buttons">
                <a href="/admin-crear" class="dashboard-button" title="Agregar Administrador">
                    <i class="bi bi-person-plus"></i> Agregar Admin
                </a>

                <a href="/admin-obtener-citas" class="dashboard-button" title="Calendario">
                    <i class="bi bi-calendar-event"></i> Calendario
                </a>

                <!-- Botón: Citas Agendadas -->
                <a href="/admin-citas-agendadas" class="dashboard-button" title="Citas Agendadas">
                    <i class="bi bi-calendar-check-fill"></i> Citas Agendadas
                </a>

                <a href="/admin-todos-historiales" class="dashboard-button" title="Historiales Clínicos">
                    <i class="bi bi-folder2-open"></i> Historiales Clínicos
                </a>

                <a href="/admin-testimonios" class="dashboard-button" title="Agregar Testimonio">
                    <i class="bi bi-chat-square-text"></i> Agregar Testimonio
                </a>
                <!-- Botón: Lista de Usuarios -->
                <a href="/admin-lista-usuarios" class="dashboard-button" title="Lista de Usuarios">
                    <i class="bi bi-people-fill"></i> Lista de Usuarios
                </a>

                <div class="dashboard-button" title="Hora Actual" id="clock">
                    <i class="bi bi-clock"></i>
                    <div class="clock" id="timeDisplay">--:--:--</div>
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            // Actualizar reloj digital en tiempo real
            function updateClock() {
                const now = new Date();
                const h = String(now.getHours()).padStart(2, '0');
                const m = String(now.getMinutes()).padStart(2, '0');
                const s = String(now.getSeconds()).padStart(2, '0');
                document.getElementById('timeDisplay').textContent = `${h}:${m}:${s}`;
            }
            setInterval(updateClock, 1000);
            updateClock();
        </script>
</body>

</html>