<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <title>Imprimir Historial Clínico Completo</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Roboto&display=swap');
        body {
            font-family: 'Roboto', Arial, sans-serif;
            margin: 40px;
            background-color: #f9f9f9;
            color: #333;
        }
        
        .header-logo {
            text-align: center;
            margin-bottom: 20px;
        }
        
        .header-logo img {
            max-height: 80px;
            margin: 0 auto 10px;
            display: block;
        }
        
        .doctor-name {
            font-weight: bold;
            font-size: 1.2rem;
            color: #004085;
        }
        
        h1 {
            text-align: center;
            border-bottom: 3px solid #007bff;
            padding-bottom: 10px;
            color: #004085;
        }
        
        .perfil-paciente {
            max-width: 1000px;
            margin: 0 auto 40px;
        }
        
        .perfil-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px 30px;
            font-size: 14px;
        }
        
        .perfil-label {
            font-weight: 700;
            color: #222;
        }
        
        table {
            width: 100%;
            border-collapse: collapse;
            background-color: #fff;
            box-shadow: 0 0 10px rgba(0, 123, 255, 0.15);
            font-size: 14px;
        }
        
        thead {
            background-color: #007bff;
            color: white;
        }
        
        th,
        td {
            border: 1px solid #ddd;
            padding: 12px;
            vertical-align: top;
        }
        
        pre {
            white-space: pre-wrap;
            font-family: 'Roboto', monospace;
        }
        
        #btnPrint {
            background-color: #007bff;
            color: white;
            padding: 10px 20px;
            margin: 20px auto;
            display: block;
            font-weight: bold;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }
        
        #btnPrint:hover {
            background-color: #0056b3;
        }
        
        .odontograma-svg {
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
        }
        
        .diente-svg {
            width: 40px;
            height: 40px;
        }
        
        @media print {
            #btnPrint {
                display: none;
            }
        }
    </style>
</head>

<body>
    <button id="btnPrint" onclick="window.print()">🖨️ Imprimir Historial Completo</button>

    <div class="header-logo">
        <img src="/images/Logo.jpg" alt="Logo Consultorio" />
        <div class="doctor-name">Dra. Joseline Delgado<br>Odontología Especializada</div>
    </div>

    <h1>Historial Clínico Completo - (N° HC:
        <%= paciente.cedula %>)</h1>

    <section class="perfil-paciente">
        <div class="perfil-grid">
            <div class="perfil-label">Nombre:</div>
            <div>
                <%= paciente.nombre %>
            </div>
            <div class="perfil-label">Cédula:</div>
            <div>
                <%= paciente.cedula %>
            </div>
            <div class="perfil-label">Edad:</div>
            <div>
                <%= paciente.edad || 'N/A' %>
            </div>
            <div class="perfil-label">Sexo:</div>
            <div>
                <%= paciente.sexo || 'N/A' %>
            </div>
            <div class="perfil-label">Ciudad:</div>
            <div>
                <%= paciente.ciudad || 'N/A' %>
            </div>
            <div class="perfil-label">Celular:</div>
            <div>
                <%= paciente.celular || 'N/A' %>
            </div>
            <div class="perfil-label">Ciudad:</div>
            <div>
                <%= paciente.ciudad || 'N/A' %>
            </div>
            <div class="perfil-label">Barrio:</div>
            <div>
                <%= paciente.barrio || 'N/A' %>
            </div>
            <div class="perfil-label">Ocupación:</div>
            <div>
                <%= paciente.ocupacion || 'N/A' %>
            </div>
            <div class="perfil-label">Alergias:</div>
            <div>
                <%= paciente.alergias || 'N/A' %>
            </div>
            <div class="perfil-label">Antecedentes Personales:</div>
            <div>
                <%= paciente.antecedentes_personales || 'N/A' %>
            </div>
            <div class="perfil-label">Antecedentes Familiares:</div>
            <div>
                <%= paciente.antecedentes_familiares || 'N/A' %>
            </div>
            <div class="perfil-label">Medicamentos Actuales:</div>
            <div>
                <%= paciente.medicamentos_actuales || 'N/A' %>
            </div>
            <div class="perfil-label">Cirugías:</div>
            <div>
                <%= paciente.cirugias || 'N/A' %>
            </div>
            <div class="perfil-label">Enfermedades Crónicas:</div>
            <div>
                <%= paciente.enfermedades_cronicas || 'N/A' %>
            </div>
            <div class="perfil-label">Grupo Sanguíneo:</div>
            <div>
                <%= paciente.grupo_sanguineo || 'N/A' %>
            </div>
            <div class="perfil-label">Fuma:</div>
            <div>
                <%= paciente.fuma ? 'Sí' : 'No' %>
            </div>
            <div class="perfil-label">Consume Alcohol:</div>
            <div>
                <%= paciente.alcohol ? 'Sí' : 'No' %>
            </div>
            <div class="perfil-label">Enfermedades Contagiosas Recientes:</div>
            <div>
                <%= paciente.enfermedades_contagiosas_recientes || 'N/A' %>
            </div>
        </div>
    </section>

    <table>
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Código Diagnóstico</th>
                <th>Nombre Diagnóstico</th>
                <th>Tratamientos</th>
                <th>Medicamentos</th>
                <th>Prescripción</th>
                <th>Observaciones</th>
                <th>Odontograma</th>
            </tr>
        </thead>
        <tbody>
            <% historiales.forEach(hist => { %>
                <tr>
                    <td>
                        <%= new Date(hist.created_at).toLocaleDateString() %>
                    </td>
                    <td>
                        <%= hist.codigo_diagnostico || '—' %>
                    </td>
                    <td>
                        <%= hist.nombre_diagnostico || '—' %>
                    </td>
                    <td><pre><%= hist.tratamientos || '—' %></pre></td>
                    <td><pre><%= hist.medicamentos || '—' %></pre></td>
                    <td><pre><%= hist.prescripcion || '—' %></pre></td>
                    <td><pre><%= hist.observaciones || '—' %></pre></td>
                    <td>
                        <div class="odontograma-svg">
                            <% const piezas = JSON.parse(hist.odontograma_json || "[]"); piezas.forEach(p => { %>
                                <svg class="diente-svg" viewBox="0 0 50 50">
                  <circle cx="25" cy="25" r="20" stroke="#333" stroke-width="2" fill="#ffffff" />
                  <circle cx="25" cy="25" r="10" fill="#007bff" />
                  <text x="25" y="47" font-size="10" text-anchor="middle" fill="#333"><%= p %></text>
                </svg>
                                <% }) %>
                        </div>
                    </td>
                </tr>
                <% }) %>
        </tbody>
    </table>
</body>

</html>